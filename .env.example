# Modal profile this repo uses (`modal profile list`). Deploys, downloads, the lab and setup_token.py
# stop when another profile is active.
RIVERFIELD_MODAL_PROFILE=
# Gateway in front of comfy-api-proxy (the Modal URL printed by `modal deploy infra/modal_app.py`,
# or http://127.0.0.1:8000 when running the gateway locally).
COMFY_BASE_URL=https://YOUR-WORKSPACE--riverfield-serve.modal.run
# Written by `python tools/setup_token.py`, which stores the same value in the Modal secret "riverfield".
RIVERFIELD_TOKEN=
# Passcode of the hosted demo (infra/web_app.py), written by `python tools/setup_demo.py`; only --link reads it here.
RIVERFIELD_DEMO_PASSCODE=
# Let the web UI and the CLI run draft apps too (their workflows have not been run on a GPU yet).
# RIVERFIELD_DRAFTS=1
# Extra Host names accepted by a server listening on loopback (a LAN name, a tunnel), comma-separated.
# RIVERFIELD_ALLOWED_HOSTS=studio.lan
# On your own pod or GPU, every browser with the passcode shares one history (default off on a public demo).
# RIVERFIELD_SHARED_HISTORY=1
