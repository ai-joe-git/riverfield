{
  "$schema": "../../schema/app.schema.json",
  "id": "h3-photo",
  "name": "H3 Photo to Video",
  "section": "video",
  "summary": "Animates a photo into a clip with its own sound on MiniMax H3; the clip keeps the photo's shape.",
  "higgsfield_feature": "Create Video",
  "pack": "video-h3",
  "status": "ready",
  "workflow": "workflow.api.json",
  "source": {
    "template": "video_minimax_h3_i2v.json",
    "comfyui": "0.42.0",
    "notes": "Comfy's video_minimax_h3_i2v template with the int8 text encoder in place of the NVFP4 one (it needs a Blackwell GPU) and the plain 20-step branch of its turbo switch wired in: lightx2v's turbo LoRA is left out, its model card states no license (tools/build_apps.py). The photo, scaled to 0.6 MP in steps of 32, sets the clip's size."
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Photo",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "114",
          "field": "image"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "What happens",
      "required": true,
      "default": "The person smiles, waves at the camera and says: \"Hey, good to see you.\"",
      "help": "Put spoken words in quotes; describe sounds and music too.",
      "bind": [
        {
          "node": "105:104",
          "field": "prompt"
        }
      ]
    },
    {
      "id": "resolution",
      "type": "slider",
      "label": "Resolution (MP)",
      "min": 0.1,
      "max": 2.0,
      "step": 0.1,
      "default": 0.6,
      "help": "For Photo, this is the source-image budget before the H3 encoder.",
      "bind": [
        {
          "node": "119",
          "field": "megapixels"
        }
      ]
    },
    {
      "id": "unet_name",
      "type": "select",
      "label": "Diffusion model (DiT)",
      "default": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "options": [
        {
          "value": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
          "label": "H3 FL2VA pruned INT8"
        },
        {
          "value": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
          "label": "H3 Ref2VA pruned INT8"
        },
        {
          "value": "minimax_h3_image_pruned_int8_convrot.safetensors",
          "label": "H3 Image pruned INT8"
        }
      ],
      "bind": [
        {
          "node": "105:6",
          "field": "unet_name"
        }
      ]
    },
    {
      "id": "vae_name",
      "type": "select",
      "label": "Video VAE",
      "default": "minimax_h3_video_vae_int8_convrot.safetensors",
      "options": [
        {
          "value": "minimax_h3_video_vae_int8_convrot.safetensors",
          "label": "Video VAE INT8 (2.8 GB)"
        },
        {
          "value": "minimax_h3_lynnreal_light_vae_int8_convrot.safetensors",
          "label": "Lynnreal light INT8 (2.1 GB)"
        },
        {
          "value": "minimax_h3_video_vae_fp16.safetensors",
          "label": "Video VAE FP16 (5.2 GB)"
        }
      ],
      "bind": [
        {
          "node": "105:11",
          "field": "vae_name"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Duration (s)",
      "min": 2,
      "max": 40,
      "step": 1,
      "default": 4,
      "help": "Up to 40. The frame count is 24 fps rounded up to the H3 5+17n grid (40 s = 974 frames).",
      "bind": [
        {
          "node": "105:111",
          "field": "value"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 8,
      "max": 30,
      "step": 1,
      "default": 20,
      "help": "Fewer steps run faster and look rougher.",
      "bind": [
        {
          "node": "105:124",
          "field": "value"
        }
      ]
    },
    {
      "id": "sampler",
      "type": "select",
      "label": "Sampler",
      "default": "res_multistep",
      "options": [
        {
          "value": "res_multistep",
          "label": "res_multistep"
        },
        {
          "value": "euler",
          "label": "euler"
        },
        {
          "value": "euler_ancestral",
          "label": "euler_ancestral"
        },
        {
          "value": "dpmpp_2m",
          "label": "dpmpp_2m"
        },
        {
          "value": "dpmpp_2m_sde",
          "label": "dpmpp_2m_sde"
        },
        {
          "value": "lcm",
          "label": "lcm"
        }
      ],
      "bind": [
        {
          "node": "105:17",
          "field": "sampler_name"
        }
      ]
    },
    {
      "id": "scheduler",
      "type": "select",
      "label": "Scheduler",
      "default": "simple",
      "options": [
        {
          "value": "simple",
          "label": "simple"
        },
        {
          "value": "sgm_uniform",
          "label": "sgm_uniform"
        },
        {
          "value": "karras",
          "label": "karras"
        },
        {
          "value": "exponential",
          "label": "exponential"
        },
        {
          "value": "ddim_uniform",
          "label": "ddim_uniform"
        },
        {
          "value": "beta",
          "label": "beta"
        },
        {
          "value": "normal",
          "label": "normal"
        },
        {
          "value": "linear_quadratic",
          "label": "linear_quadratic"
        },
        {
          "value": "kl_optimal",
          "label": "kl_optimal"
        }
      ],
      "bind": [
        {
          "node": "105:9",
          "field": "scheduler"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "105:15",
          "field": "noise_seed"
        }
      ]
    },
    {
      "id": "clip_name",
      "type": "select",
      "label": "Text encoder",
      "default": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "options": [
        {
          "value": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
          "label": "Qwen3-VL 32B INT8 (27.1 GB)"
        },
        {
          "value": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
          "label": "Qwen3-VL 32B NVFP4 (15.7 GB)"
        },
        {
          "value": "qwen3vl_32b_minimax_h3_ultra_uncensored_heretic_int8_convrot.safetensors",
          "label": "Qwen3-VL 32B Heretic INT8 (25 GB)"
        }
      ],
      "bind": [
        {
          "node": "105:13",
          "field": "clip_name"
        }
      ]
    },
    {
      "id": "sla",
      "type": "toggle",
      "label": "Sparse attention (H3 SLA)",
      "default": true,
      "help": "The ROCm H3 SLA node. Off, or on a backend that does not ship it: the node is bypassed.",
      "bind": [
        {
          "node": "105:125",
          "field": "enabled"
        }
      ],
      "bypass": [
        {
          "node": "105:125",
          "field": "model"
        }
      ]
    },
    {
      "id": "sla_detail",
      "type": "slider",
      "label": "SLA sparsity",
      "min": 0.5,
      "max": 0.95,
      "step": 0.05,
      "default": "0.9",
      "help": "Fraction of key blocks skipped. Lower keeps more exact blocks and costs time.",
      "bind": [
        {
          "node": "105:125",
          "field": "sparsity_ratio"
        }
      ]
    },
    {
      "id": "sla_block_size",
      "type": "select",
      "label": "SLA block size",
      "default": "64",
      "options": [
        {
          "value": "32",
          "label": "32 — finest"
        },
        {
          "value": "64",
          "label": "64 — balanced"
        },
        {
          "value": "128",
          "label": "128 — fastest"
        }
      ],
      "bind": [
        {
          "node": "105:125",
          "field": "block_size"
        }
      ]
    },
    {
      "id": "sla_min_seq_len",
      "type": "number",
      "label": "SLA min sequence length",
      "min": 0,
      "max": 1000000,
      "step": 1024,
      "default": 8192,
      "bind": [
        {
          "node": "105:125",
          "field": "min_seq_len"
        }
      ]
    },
    {
      "id": "sla_dense_last_steps",
      "type": "slider",
      "label": "SLA dense last steps",
      "min": 0,
      "max": 8,
      "step": 1,
      "default": 1,
      "bind": [
        {
          "node": "105:125",
          "field": "dense_last_steps"
        }
      ]
    },
    {
      "id": "sla_protect_audio",
      "type": "toggle",
      "label": "SLA protect audio",
      "default": true,
      "bind": [
        {
          "node": "105:125",
          "field": "protect_audio"
        }
      ]
    },
    {
      "id": "sla_stabilize_motion",
      "type": "toggle",
      "label": "SLA stabilize motion",
      "default": false,
      "bind": [
        {
          "node": "105:125",
          "field": "stabilize_motion"
        }
      ]
    },
    {
      "id": "sla_h3_cache",
      "type": "toggle",
      "label": "H3 cache",
      "default": false,
      "bind": [
        {
          "node": "105:125",
          "field": "h3_cache"
        }
      ]
    },
    {
      "id": "sla_reference_protection",
      "type": "toggle",
      "label": "SLA protect video refs",
      "default": false,
      "bind": [
        {
          "node": "105:125",
          "field": "reference_protection"
        }
      ]
    },
    {
      "id": "sla_dense_steps",
      "type": "text",
      "label": "SLA dense steps",
      "default": "",
      "help": "Explicit 0-based step indices to force dense, e.g. '0,1' or '0-2'.",
      "bind": [
        {
          "node": "105:125",
          "field": "dense_steps"
        }
      ]
    },
    {
      "id": "sla_dense_backend",
      "type": "select",
      "label": "SLA dense backend",
      "default": "comfy_kitchen",
      "options": [
        {
          "value": "comfy_kitchen",
          "label": "comfy_kitchen"
        },
        {
          "value": "pytorch",
          "label": "pytorch"
        },
        {
          "value": "auto",
          "label": "auto"
        },
        {
          "value": "sage:auto",
          "label": "sage:auto"
        },
        {
          "value": "sage:qk_int8_pv_fp16_cuda",
          "label": "sage:qk_int8_pv_fp16_cuda"
        },
        {
          "value": "sage:qk_int8_pv_fp16_triton",
          "label": "sage:qk_int8_pv_fp16_triton"
        },
        {
          "value": "sage:qk_int8_pv_fp8_cuda",
          "label": "sage:qk_int8_pv_fp8_cuda"
        },
        {
          "value": "sage:qk_int8_pv_fp8_cuda++",
          "label": "sage:qk_int8_pv_fp8_cuda++"
        }
      ],
      "bind": [
        {
          "node": "105:125",
          "field": "dense_backend"
        }
      ]
    },
    {
      "id": "sla_disable_fp16_accum",
      "type": "toggle",
      "label": "SLA disable fp16 accumulation",
      "default": true,
      "bind": [
        {
          "node": "105:125",
          "field": "disable_fp16_accum"
        }
      ]
    },
    {
      "id": "upscale",
      "type": "select",
      "label": "Upscale",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "None — native model resolution"
        },
        {
          "value": "x2",
          "label": "2× — RelayVSR x2 (lightx2v DIT + Flash VAE)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x2_lightx2v_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x2_fp32.safetensors"
            }
          ]
        },
        {
          "value": "x4",
          "label": "4× — RelayVSR x4 (the paper's 4× model)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x4_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x4_fp32.safetensors"
            }
          ]
        }
      ],
      "help": "Optional RelayVSR pass on the decoded frames before encoding. None keeps the native result; x2/x4 use the matching DIT and Flash VAE, and x4 multiplies pixels by 16 and is slow.",
      "bypass": [
        {
          "node": "vsr_decode",
          "field": "images"
        }
      ]
    },
    {
      "id": "upscale_detail",
      "type": "slider",
      "label": "Upscale detail",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "help": "RelayVSR: how much of what the Flash decoder adds on top of a plain bicubic upscale is kept. 1 is the full model output, lower is calmer and closer to the source.",
      "bind": [
        {
          "node": "vsr_decode",
          "field": "detail"
        }
      ]
    },
    {
      "id": "filename_prefix",
      "type": "text",
      "label": "File name prefix",
      "default": "riverfield/h3-photo",
      "bind": [
        {
          "node": "92",
          "field": "filename_prefix"
        }
      ]
    },
    {
      "id": "format",
      "type": "select",
      "label": "Container",
      "default": "mp4",
      "options": [
        {
          "value": "mp4",
          "label": "MP4"
        },
        {
          "value": "mkv",
          "label": "MKV"
        },
        {
          "value": "webm",
          "label": "WebM"
        },
        {
          "value": "mov",
          "label": "MOV"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "bind": [
        {
          "node": "92",
          "field": "format"
        }
      ]
    },
    {
      "id": "codec",
      "type": "select",
      "label": "Codec",
      "default": "h264",
      "options": [
        {
          "value": "h264",
          "label": "H.264"
        },
        {
          "value": "av1",
          "label": "AV1"
        },
        {
          "value": "prores",
          "label": "ProRes"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "bind": [
        {
          "node": "92",
          "field": "format.codec"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "92",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 20.97,
      "phase": "denoise",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "text_encoders/qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 27.14,
      "phase": "encode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_video_vae_int8_convrot.safetensors",
      "dir": "vae",
      "gb": 2.81,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_audio_vae_fp32.safetensors",
      "dir": "vae",
      "gb": 0.61,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "diffusion_models/relayvsr_x2_lightx2v_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.16,
      "phase": "denoise",
      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "vae/relayvsr_flash_vae_x2_fp32.safetensors",
      "dir": "vae",
      "gb": 0.13,
      "phase": "decode",
      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "diffusion_models/relayvsr_x4_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.16,
      "phase": "denoise",
      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "vae/relayvsr_flash_vae_x4_fp32.safetensors",
      "dir": "vae",
      "gb": 0.13,
      "phase": "decode",
      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "diffusion_models/minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 20.97,
      "phase": "denoise",
      "license": "MiniMax H3 Community License",
      "optional": true
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "diffusion_models/minimax_h3_image_pruned_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 20.97,
      "phase": "denoise",
      "license": "MiniMax H3 Community License",
      "optional": true
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "dir": "text_encoders",
      "gb": 15.69,
      "phase": "encode",
      "license": "MiniMax H3 Community License",
      "optional": true
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "text_encoders/qwen3vl_32b_minimax_h3_ultra_uncensored_heretic_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 25.0,
      "phase": "encode",
      "license": "MiniMax H3 Community License",
      "optional": true
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_lynnreal_light_vae_int8_convrot.safetensors",
      "dir": "vae",
      "gb": 2.14,
