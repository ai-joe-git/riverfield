{
  "$schema": "../../schema/app.schema.json",
  "id": "ltx-director-ref",
  "name": "RiverField LTX Director (References)",
  "section": "video",
  "pack": "video-ltx",
  "status": "ready",
  "summary": "Same LTX 2.5 director, with a reference sheet: the Ingredients IC-LoRA holds your characters, props and sets across every shot.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "LTX_2_5_Director_CS.json (CGlide/LTX-2.5-Director) + LTX_Director_2_Workflow_Distilled.json (WhatDreamsCost)",
    "comfyui": "0.43.0",
    "notes": "LTXDirectorCS25 timeline fed by the RiverFieldLTXPlanner node (local/custom_nodes/riverfield-ltx-planner). The panel stores windows in 24 fps panel frames; the planner converts them to seconds and snaps the total to the LTX 8n+1 grid. Native AV: LTXVConcatAVLatent + LTXVAudioVAEDecode, no separate audio pass. The SageAttention / Triton patches of the example are removed: they wedge gfx1151. Stage 1 runs the distilled transformer at half resolution (scale_by 0.5) with the official 8-step sigmas, stage 2 refines the latent x2 in 3 steps."
  },
  "outputs": [
    {
      "node": "241",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "diffusion_models/ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 21.5,
      "phase": "denoise",
      "license": "LTX 2.5 Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "text_encoders/gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "dir": "text_encoders",
      "gb": 15.37,
      "phase": "encode",
      "license": "Gemma Terms of Use"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "vae/ltx-2.5-video-vae-bf16.safetensors",
      "dir": "vae",
      "gb": 1.47,
      "phase": "decode",
      "license": "LTX 2.5 Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "vae/ltx-2.5-audio-vae-bf16.safetensors",
      "dir": "vae",
      "gb": 0.36,
      "phase": "decode",
      "license": "LTX 2.5 Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "latent_upscale_models/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors",
      "dir": "latent_upscale_models",
      "gb": 1.0,
      "phase": "denoise2",
      "license": "LTX 2.5 Community License"
    }
  ],
  "higgsfield_feature": "AI Director",
  "custom_nodes": [
    {
      "repo": "https://github.com/CGlide/LTX-2.5-Director",
      "commit": "17aa8bc3e6dcebb8ebcd7265a04f3750c12ee1d7"
    }
  ],
  "notes": "Same graph as ltx-director, with the Ingredients IC-LoRA wired into both guide nodes and a reference sheet that is required. The planner turns the sheet into a still clip held on every frame (the Director's motion track only reads video files) and puts it on the motion track; the guide node applies the LoRA itself. Describe the sheet in the prompt by position (\"the woman from the left panel\") so the model knows which element to draw. Empty sheet is rejected: without a guide the LoRA would still be applied and degrade the render.",
  "layout": "director",
  "panel_title": "LTX Director",
  "inputs": [
    {
      "id": "segment_windows",
      "type": "text",
      "label": "Timeline (panel)",
      "hidden": true,
      "required": false,
      "default": "",
      "help": "Written by the director panel: windows with start/end (24 fps panel frames), per-window prompt and media assignment.",
      "bind": [
        {
          "node": "rfplan",
          "field": "segment_windows"
        }
      ]
    },
    {
      "id": "global_prompt",
      "type": "textarea",
      "label": "Global prompt",
      "hidden": true,
      "required": false,
      "default": "",
      "help": "Scene, characters, style. Anchors every shot and is reused by shots whose own prompt is empty.",
      "bind": [
        {
          "node": "rfplan",
          "field": "global_prompt"
        }
      ]
    },
    {
      "id": "reference_sheet",
      "type": "image",
      "label": "Reference sheet",
      "required": true,
      "limits": {
        "max_mb": 30
      },
      "help": "One image holding the characters, props and sets side by side. Describe them by position in the prompt (\"the woman from the left panel\"). The sheet is held on every frame through the Ingredients IC-LoRA.",
      "bind": [
        {
          "node": "rfplan",
          "field": "reference_sheet"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Duration (s)",
      "min": 1,
      "max": 30,
      "step": 0.5,
      "default": 5,
      "help": "Total length when the panel has no windows. With windows, their extent wins and the planner snaps it to the LTX 8n+1 grid.",
      "hidden": true,
      "bind": [
        {
          "node": "rfplan",
          "field": "duration"
        }
      ]
    },
    {
      "id": "fps",
      "type": "slider",
      "label": "Frame rate",
      "min": 8,
      "max": 30,
      "step": 1,
      "default": 25,
      "help": "25 fps matches the LTX 2.5 templates. Lower rates give longer shots for the same frame budget.",
      "bind": [
        {
          "node": "rfplan",
          "field": "fps"
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Aspect ratio",
      "default": "16:9 (Widescreen)",
      "options": [
        {
          "value": "1:1 (Square)",
          "label": "1:1 (Square)"
        },
        {
          "value": "2:3 (Portrait Photo)",
          "label": "2:3 (Portrait Photo)"
        },
        {
          "value": "3:2 (Photo)",
          "label": "3:2 (Photo)"
        },
        {
          "value": "3:4 (Portrait Standard)",
          "label": "3:4 (Portrait Standard)"
        },
        {
          "value": "4:3 (Standard)",
          "label": "4:3 (Standard)"
        },
        {
          "value": "9:16 (Portrait Widescreen)",
          "label": "9:16 (Portrait Widescreen)"
        },
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9 (Widescreen)"
        },
        {
          "value": "21:9 (Ultrawide)",
          "label": "21:9 (Ultrawide)"
        }
      ],
      "bind": [
        {
          "node": "rfres",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "megapixels",
      "type": "slider",
      "label": "Resolution (MP)",
      "min": 0.2,
      "max": 2.0,
      "step": 0.1,
      "default": 0.9,
      "help": "Final output size. Stage 1 renders at half the linear size and stage 2 upscales the latent x2. 0.9 MP = 1280x704 in 16:9.",
      "bind": [
        {
          "node": "rfres",
          "field": "megapixels"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "28",
          "field": "noise_seed"
        }
      ]
    },
    {
      "id": "fast_draft",
      "type": "toggle",
      "label": "Fast draft (3 steps)",
      "default": false,
      "help": "Off: the official 8-step distilled schedule. On: the 3-step draft schedule, about three times faster and visibly rougher.",
      "bind": [
        {
          "node": "233",
          "field": "value"
        }
      ]
    },
    {
      "id": "sampler",
      "type": "select",
      "label": "Sampler",
      "default": "euler_ancestral",
      "options": [
        {
          "value": "euler",
          "label": "euler"
        },
        {
          "value": "euler_ancestral",
          "label": "euler_ancestral"
        },
        {
          "value": "dpmpp_2m",
          "label": "dpmpp_2m"
        },
        {
          "value": "dpmpp_2m_sde",
          "label": "dpmpp_2m_sde"
        },
        {
          "value": "res_multistep",
          "label": "res_multistep"
        }
      ],
      "bind": [
        {
          "node": "29",
          "field": "sampler_name"
        },
        {
          "node": "53",
          "field": "sampler_name"
        }
      ]
    },
    {
      "id": "unet_name",
      "type": "select",
      "label": "Diffusion model",
      "default": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "options": [
        {
          "value": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
          "label": "LTX 2.5 22B distilled (int8 convrot)"
        }
      ],
      "bind": [
        {
          "node": "94",
          "field": "unet_name"
        }
      ]
    },
    {
      "id": "weight_dtype",
      "type": "select",
      "label": "Weight dtype",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "default"
        },
        {
          "value": "fp8_e4m3fn",
          "label": "fp8_e4m3fn"
        },
        {
          "value": "fp8_e4m3fn_fast",
          "label": "fp8_e4m3fn_fast"
        },
        {
          "value": "fp8_e5m2",
          "label": "fp8_e5m2"
        }
      ],
      "bind": [
        {
          "node": "94",
          "field": "weight_dtype"
        }
      ]
    },
    {
      "id": "clip_name",
      "type": "select",
      "label": "Text encoder",
      "default": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "options": [
        {
          "value": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
          "label": "Gemma 4 12B + LTX 2.5 projection (int8 convrot)"
        }
      ],
      "bind": [
        {
          "node": "226",
          "field": "clip_name"
        }
      ]
    },
    {
      "id": "vae_name",
      "type": "select",
      "label": "Video VAE",
      "default": "ltx-2.5-video-vae-bf16.safetensors",
      "options": [
        {
          "value": "ltx-2.5-video-vae-bf16.safetensors",
          "label": "LTX 2.5 video VAE (diffusion decoder, bf16)"
        }
      ],
      "bind": [
        {
          "node": "3",
          "field": "vae_name"
        }
      ]
    },
    {
      "id": "audio_vae_name",
      "type": "select",
      "label": "Audio VAE",
      "default": "ltx-2.5-audio-vae-bf16.safetensors",
      "options": [
        {
          "value": "ltx-2.5-audio-vae-bf16.safetensors",
          "label": "LTX 2.5 audio VAE (bf16)"
        }
      ],
      "bind": [
        {
          "node": "4",
          "field": "vae_name"
        }
      ]
    },
    {
      "id": "upscaler",
      "type": "select",
      "label": "Latent upscaler",
      "default": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors",
      "options": [
        {
          "value": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors",
          "label": "LTX 2.5 spatial upscaler x2"
        }
      ],
      "bind": [
        {
          "node": "57",
          "field": "model_name"
        }
      ]
    }
  ]
}
