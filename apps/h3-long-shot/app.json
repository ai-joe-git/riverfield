{
  "$schema": "../../schema/app.schema.json",
  "id": "h3-long-shot",
  "name": "H3 Long Shot",
  "section": "video",
  "pack": "video-h3",
  "status": "ready",
  "summary": "One picture and one prompt make a single unbroken H3 take, with voice and sound, up to 40 seconds.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "PikaRiver-H3-Long-Shot-FIXED.json (StableYogi H3 Long Shot)",
    "comfyui": "0.43.0",
    "notes": "MiniMaxH3ImageToVideo + the Pika lcm 6-step sigmas by default; the length is snapped to 5+17n frames by a ComfyMathExpression from the duration in seconds. The optional SeedVR2 upscale group of the original is not included."
  },
  "outputs": [
    {
      "node": "21",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 20.97,
      "phase": "denoise",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "dir": "text_encoders",
      "gb": 17.0,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_lynnreal_light_vae_int8_convrot.safetensors",
      "dir": "vae",
      "gb": 2.0,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_audio_vae_fp32.safetensors",
      "dir": "vae",
      "gb": 0.4,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "loras/pika_h3_flex_fl2va_v1_bf16.safetensors",
      "dir": "loras",
      "gb": 1.9,
      "phase": "denoise",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "diffusion_models/relayvsr_x2_lightx2v_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.16,
      "phase": "denoise",
      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "vae/relayvsr_flash_vae_x2_fp32.safetensors",
      "dir": "vae",
      "gb": 0.13,
      "phase": "decode",
      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "diffusion_models/relayvsr_x4_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.16,
      "phase": "denoise",
      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "vae/relayvsr_flash_vae_x4_fp32.safetensors",
      "dir": "vae",
      "gb": 0.13,
      "phase": "decode",
      "license": "Apache-2.0",
      "optional": true
    }
  ],
  "notes": "The duration slider is snapped to an H3-legal 5+17n frame count (5 s = 124, 10 s = 243, 20 s = 481, 30 s = 719, 40 s ~ 974). Speech is about 2.5 words a second, so a 40 s take needs about 100 words. The default Pika LoRA uses the lcm sampler and its 6-step sigma ladder; the other H3 LoRAs switch to Custom sampling, their trained step count and euler through a BasicScheduler.",
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Start frame",
      "required": true,
      "limits": {
        "max_mb": 60
      },
      "bind": [
        {
          "node": "7",
          "field": "image"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Prompt",
      "required": true,
      "default": "A static, locked-off medium close-up, like a phone propped on the pool edge. A 23-year-old woman, an adult, with long wavy light-brown hair, a natural tan and light natural make-up, wears a simple white bikini top. She stands chest-deep in the clear blue water of a sunny villa pool and rests her forearms on the tiled edge. Palm trees and a white wall behind her, bright late-morning sun, soft water reflections. She talks to the camera in a bright, friendly influencer way, smiles often and moves one hand a little while she explains. [ENGLISH] She says, in a light, warm, cheerful voice: \"Good morning from the pool! You asked about my morning routine, so here it is. I wake up at seven and drink a big glass of water. Then a short swim, ten minutes, nothing crazy. It wakes me up better than coffee. After that, sun cream, always, even on cloudy days. People think the glow is a filter. It is not. It is sleep, water and sun cream. Breakfast is simple: fruit, yoghurt and a little honey. Then I plan my day right here by the water. Tell me your routine in the comments. See you tomorrow, bye!\" After the last word, she smiles, waves once and says nothing more. Sound: soft pool water and light birdsong under the voice. One continuous shot, no cuts, the camera does not move. No subtitles, no captions, no on-screen text, no watermark.",
      "bind": [
        {
          "node": "8",
          "field": "value"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Duration (s)",
      "min": 5,
      "max": 40,
      "step": 1,
      "default": 40,
      "help": "Snapped to the H3 5+17n frame grid.",
      "bind": [
        {
          "node": "33",
          "field": "value"
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Aspect ratio",
      "default": "16:9 (Widescreen)",
      "options": [
        {
          "value": "1:1 (Square)",
          "label": "1:1 (Square)"
        },
        {
          "value": "3:4 (Portrait Standard)",
          "label": "3:4 (Portrait Standard)"
        },
        {
          "value": "9:16 (Portrait Widescreen)",
          "label": "9:16 (Portrait Widescreen)"
        },
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9 (Widescreen)"
        },
        {
          "value": "21:9 (Ultrawide)",
          "label": "21:9 (Ultrawide)"
        }
      ],
      "bind": [
        {
          "node": "32",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "megapixels",
      "type": "slider",
      "label": "Resolution (MP)",
      "min": 0.1,
      "max": 4.0,
      "step": 0.01,
      "default": 0.4,
      "bind": [
        {
          "node": "32",
          "field": "megapixels"
        }
      ],
      "help": "0.4 MP ≈ 848×480 at 16:9, rounded to a multiple of 32. Up to 4 MP."
    },
    {
      "id": "upscale",
      "type": "select",
      "label": "Upscale",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "None — native model resolution"
        },
        {
          "value": "x2",
          "label": "2× — RelayVSR x2 (lightx2v DIT + Flash VAE)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x2_lightx2v_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x2_fp32.safetensors"
            }
          ]
        },
        {
          "value": "x4",
          "label": "4× — RelayVSR x4 (the paper's 4× model)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x4_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x4_fp32.safetensors"
            }
          ]
        }
      ],
      "help": "Optional RelayVSR pass on the decoded frames before encoding. None keeps the native result; x2/x4 use the matching DIT and Flash VAE, and x4 multiplies pixels by 16 and is slow.",
      "bypass": [
        {
          "node": "vsr_decode",
          "field": "images"
        }
      ]
    },
    {
      "id": "upscale_detail",
      "type": "slider",
      "label": "Upscale detail",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "help": "RelayVSR: how much of what the Flash decoder adds on top of a plain bicubic upscale is kept. 1 is the full model output, lower is calmer and closer to the source.",
      "bind": [
        {
          "node": "vsr_decode",
          "field": "detail"
        }
      ]
    },
    {
      "id": "detail",
      "type": "slider",
      "label": "Sparse attention: detail",
      "min": 0.8,
      "max": 0.95,
      "step": 0.05,
      "default": 0.9,
      "help": "Sparsity (higher = faster). 0.9 is what the Pika template uses; 0.85 keeps more exact blocks.",
      "bind": [
        {
          "node": "35",
          "field": "sparsity_ratio"
        }
      ]
    },
    {
      "id": "sla",
      "type": "toggle",
      "label": "Sparse attention (H3 SLA)",
      "default": true,
      "help": "The ROCm SLA node. Turn it off on CUDA/XPU, or on a backend that does not ship it: the node is bypassed and the model goes straight to the sampler. It is also bypassed automatically when the backend lacks the class.",
      "bind": [
        {
          "node": "35",
          "field": "enabled"
        }
      ],
      "bypass": [
        {
          "node": "35",
          "field": "model"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": 4242,
      "bind": [
        {
          "node": "13",
          "field": "noise_seed"
        }
      ]
    },
    {
      "id": "unet_name",
      "type": "select",
      "label": "Diffusion model",
      "default": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "options": [
        {
          "value": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
          "label": "minimax_h3_fl2va_pruned_int8_convrot"
        }
      ],
      "bind": [
        {
          "node": "2",
          "field": "unet_name"
        }
      ]
    },
    {
      "id": "clip_name",
      "type": "select",
      "label": "Text encoder",
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "options": [
        {
          "value": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
          "label": "qwen3vl_32b_minimax_h3_nvfp4_awq"
        }
      ],
      "bind": [
        {
          "node": "3",
          "field": "clip_name"
        }
      ]
    },
    {
      "id": "vae_name",
      "type": "select",
      "label": "Video VAE",
      "default": "minimax_h3_lynnreal_light_vae_int8_convrot.safetensors",
      "options": [
        {
          "value": "minimax_h3_lynnreal_light_vae_int8_convrot.safetensors",
          "label": "minimax_h3_lynnreal_light_vae_int8_convrot"
        }
      ],
      "bind": [
        {
          "node": "4",
          "field": "vae_name"
        }
      ]
    },
    {
      "id": "audio_vae_name",
      "type": "select",
      "label": "Audio VAE",
      "default": "minimax_h3_audio_vae_fp32.safetensors",
      "options": [
        {
          "value": "minimax_h3_audio_vae_fp32.safetensors",
          "label": "minimax_h3_audio_vae_fp32"
        }
      ],
      "bind": [
        {
          "node": "5",
          "field": "vae_name"
        }
      ]
    },
    {
      "id": "lora_name",
      "type": "select",
      "label": "LoRA",
      "default": "pika_h3_flex_fl2va_v1_bf16.safetensors",
      "options": [
        {
          "value": "pika_h3_flex_fl2va_v1_bf16.safetensors",
          "label": "Pika H3 Flex FL2VA v1 — default, 6-step ladder",
          "sync": {
            "steps": 6,
            "sampler": "lcm",
            "sampling": "pika"
          }
        },
        {
          "value": "taomate_h3_3step_comfy.safetensors",
          "label": "TaoMate H3 3-step — fastest, 3-step",
          "sync": {
            "steps": 3,
            "sampler": "euler",
            "sampling": "custom"
          }
        },
        {
          "value": "minimax_h3_fl2v_turbo_4step_v1.2_768p_comfyui_bf16.safetensors",
          "label": "MiniMax H3 FL2V turbo 4-step v1.2 768p",
          "sync": {
            "steps": 4,
            "sampler": "euler",
            "sampling": "custom"
          }
        },
        {
          "value": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
          "label": "MiniMax H3 FL2V turbo 8-step v1.0",
          "sync": {
            "steps": 8,
            "sampler": "euler",
            "sampling": "custom"
          }
        },
        {
          "value": "minimax_h3_DMAD_4step_full_lora_avg_rank_39_bf16.safetensors",
          "label": "MiniMax H3 DMAD 4-step",
          "sync": {
            "steps": 4,
            "sampler": "euler",
            "sampling": "custom"
          }
        },
        {
          "value": "minimax_h3_pdmd_2step_lora_avg_rank_38_bf16.safetensors",
          "label": "MiniMax H3 PDMD 2-step",
          "sync": {
            "steps": 2,
            "sampler": "euler",
            "sampling": "custom"
          }
        },
        {
          "value": "minimax_h3_pdmd_4step_lora_avg_rank_57_bf16.safetensors",
          "label": "MiniMax H3 PDMD 4-step",
          "sync": {
            "steps": 4,
            "sampler": "euler",
            "sampling": "custom"
          }
        },
        {
          "value": "minimax_h3_turbo_v4_step600_ema_comfyui.safetensors",
          "label": "MiniMax H3 turbo v4 step600 EMA (4-step)",
          "sync": {
            "steps": 4,
            "sampler": "euler",
            "sampling": "custom"
          }
        }
      ],
      "bind": [
        {
          "node": "31",
          "field": "lora_name"
        }
      ],
      "help": "The H3 adapter. Pika uses the shipped lcm 6-step ladder; the turbo and distilled LoRAs switch to Custom sampling with their trained step count and euler."
    },
    {
      "id": "lora_strength",
      "type": "slider",
      "label": "LoRA strength",
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "default": 1.0,
      "bind": [
        {
          "node": "31",
          "field": "strength_model"
        }
      ]
    },
    {
      "id": "sampling",
      "type": "select",
      "label": "Sampling",
      "default": "pika",
      "options": [
        {
          "value": "pika",
          "label": "Pika 6-step ladder (shipped)",
          "sets": [
            {
              "node": "17",
              "field": "sigmas",
              "value": [
                "28",
                0
              ]
            }
          ]
        },
        {
          "value": "custom",
          "label": "Custom steps + sampler",
          "sets": [
            {
              "node": "17",
              "field": "sigmas",
              "value": [
                "36",
                0
              ]
            }
          ]
        }
      ],
      "help": "The Pika ladder is the shipped 6-step lcm schedule. Custom uses Steps and Sampler through a BasicScheduler; picking a turbo or distilled LoRA switches to Custom automatically."
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 2,
      "max": 30,
      "step": 1,
      "default": 6,
      "help": "Only used with Custom sampling; the Pika ladder is fixed at 6 steps. Picking a LoRA sets its trained step count.",
      "bind": [
        {
          "node": "36",
          "field": "steps"
        }
      ],
      "show_if": {
        "input": "sampling",
        "equals": "custom"
      }
    },
    {
      "id": "sampler",
      "type": "select",
      "label": "Sampler",
      "default": "lcm",
      "options": [
        {
          "value": "euler",
          "label": "euler"
        },
        {
          "value": "res_multistep",
          "label": "res_multistep"
        },
        {
          "value": "lcm",
          "label": "lcm"
        },
        {
          "value": "dpmpp_2m",
          "label": "dpmpp_2m"
        },
        {
          "value": "dpmpp_2m_sde",
          "label": "dpmpp_2m_sde"
        },
        {
          "value": "dpmpp_3m_sde",
          "label": "dpmpp_3m_sde"
        },
        {
          "value": "deis",
          "label": "deis"
        },
        {
          "value": "heun",
          "label": "heun"
        },
        {
          "value": "dpm_2",
          "label": "dpm_2"
        },
        {
          "value": "dpm_2_ancestral",
          "label": "dpm_2_ancestral"
        },
        {
          "value": "lms",
          "label": "lms"
        }
      ],
      "help": "lcm is what the Pika LoRA and its sigma ladder were built for. euler is what the turbo LoRAs expect.",
      "bind": [
        {
          "node": "14",
          "field": "sampler_name"
        }
      ],
      "show_if": {
        "input": "sampling",
        "equals": "custom"
      }
    }
  ]
}
