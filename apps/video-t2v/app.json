{
  "$schema": "../../schema/app.schema.json",
  "id": "video-t2v",
  "name": "LTX 2.5 Text to Video",
  "section": "video",
  "pack": "video-ltx25",
  "status": "ready",
  "higgsfield_feature": "Create Video",
  "summary": "LTX 2.5 makes a shot with synchronized audio from a prompt; two stages, selectable resolution and up to 30 s.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "video_ltx2_5_t2v.json",
    "comfyui": "0.42.0"
  },
  "inputs": [
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Prompt",
      "required": true,
      "default": "Aerial shot gliding over a foggy pine forest at sunrise, light rays through the mist, birdsong",
      "bind": [
        {
          "node": "405:376",
          "field": "value"
        }
      ]
    },
    {
      "id": "negative_prompt",
      "type": "textarea",
      "label": "Negative prompt",
      "default": "pc game, console game, video game, cartoon, childish, ugly",
      "help": "What the model should avoid.",
      "bind": [
        {
          "node": "405:373",
          "field": "text"
        }
      ]
    },
    {
      "id": "enhance",
      "type": "toggle",
      "label": "Enhance prompt",
      "default": true,
      "help": "Rewrite the prompt with the prompt-enhancer model before sampling.",
      "bind": [
        {
          "node": "405:383",
          "field": "value"
        }
      ]
    },
    {
      "id": "enhancer_clip_name",
      "type": "select",
      "label": "Prompt enhancer model",
      "default": "gemma4_e2b_it_int8_convrot.safetensors",
      "options": [
        {
          "value": "gemma4_e2b_it_int8_convrot.safetensors",
          "label": "Gemma 4 E2B IT INT8 (4.9 GB)"
        }
      ],
      "help": "The small Gemma model used by Enhance prompt.",
      "bind": [
        {
          "node": "405:393",
          "field": "clip_name"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Duration (s)",
      "min": 2,
      "max": 30,
      "step": 1,
      "default": 5,
      "help": "24 fps, snapped to the LTX 8n+1 grid.",
      "bind": [
        {
          "node": "405:362",
          "field": "value"
        }
      ]
    },
    {
      "id": "fps",
      "type": "slider",
      "label": "Frame rate",
      "min": 8,
      "max": 30,
      "step": 1,
      "default": 24,
      "help": "Playback and conditioning frame rate. The frame count follows the duration and this rate.",
      "bind": [
        {
          "node": "405:361",
          "field": "value"
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Aspect ratio",
      "default": "16:9 (Widescreen)",
      "options": [
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9"
        },
        {
          "value": "9:16 (Portrait Widescreen)",
          "label": "9:16"
        },
        {
          "value": "1:1 (Square)",
          "label": "1:1"
        },
        {
          "value": "4:3 (Standard)",
          "label": "4:3"
        },
        {
          "value": "3:4 (Portrait Standard)",
          "label": "3:4"
        },
        {
          "value": "21:9 (Ultrawide)",
          "label": "21:9"
        }
      ],
      "bind": [
        {
          "node": "409",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "megapixels",
      "type": "slider",
      "label": "Resolution (MP)",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "default": 0.9,
      "help": "0.9 MP is about 1280x704 in 16:9.",
      "bind": [
        {
          "node": "409",
          "field": "megapixels"
        }
      ]
    },
    {
      "id": "multiple",
      "type": "select",
      "label": "Size multiple",
      "default": 32,
      "options": [
        {
          "value": 8,
          "label": "8"
        },
        {
          "value": 16,
          "label": "16"
        },
        {
          "value": 32,
          "label": "32 (LTX default)"
        },
        {
          "value": 64,
          "label": "64"
        }
      ],
      "bind": [
        {
          "node": "409",
          "field": "multiple"
        }
      ]
    },
    {
      "id": "steps",
      "type": "select",
      "label": "High-res steps",
      "default": 9,
      "options": [
        {
          "value": 9,
          "label": "9 (quality)",
          "sets": [
            {
              "node": "405:fastflag",
              "field": "value",
              "value": false
            }
          ]
        },
        {
          "value": 4,
          "label": "4 (fast draft)",
          "sets": [
            {
              "node": "405:fastflag",
              "field": "value",
              "value": true
            }
          ]
        }
      ],
      "help": "The low-resolution stage stays at 4 steps; this switches the high-resolution stage between 4 and 9 steps."
    },
    {
      "id": "sampler",
      "type": "select",
      "label": "Sampler",
      "default": "euler_ancestral",
      "options": [
        {
          "value": "euler",
          "label": "euler"
        },
        {
          "value": "euler_ancestral",
          "label": "euler_ancestral"
        },
        {
          "value": "dpmpp_2m",
          "label": "dpmpp_2m"
        },
        {
          "value": "dpmpp_2m_sde",
          "label": "dpmpp_2m_sde"
        },
        {
          "value": "res_multistep",
          "label": "res_multistep"
        }
      ],
      "bind": [
        {
          "node": "405:341",
          "field": "sampler_name"
        },
        {
          "node": "405:352",
          "field": "sampler_name"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "405:339",
          "field": "noise_seed"
        }
      ]
    },
    {
      "id": "unet_name",
      "type": "select",
      "label": "Diffusion model",
      "default": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "options": [
        {
          "value": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
          "label": "LTX 2.5 22B distilled (int8 convrot)"
        }
      ],
      "bind": [
        {
          "node": "405:384",
          "field": "unet_name"
        }
      ]
    },
    {
      "id": "weight_dtype",
      "type": "select",
      "label": "Weight dtype",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "default"
        },
        {
          "value": "fp8_e4m3fn",
          "label": "fp8_e4m3fn"
        },
        {
          "value": "fp8_e4m3fn_fast",
          "label": "fp8_e4m3fn_fast"
        },
        {
          "value": "fp8_e5m2",
          "label": "fp8_e5m2"
        }
      ],
      "bind": [
        {
          "node": "405:384",
          "field": "weight_dtype"
        }
      ]
    },
    {
      "id": "clip_name",
      "type": "select",
      "label": "Text encoder",
      "default": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "options": [
        {
          "value": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
          "label": "Gemma 4 12B + LTX 2.5 projection (int8 convrot)"
        }
      ],
      "bind": [
        {
          "node": "405:387",
          "field": "clip_name"
        }
      ]
    },
    {
      "id": "vae_name",
      "type": "select",
      "label": "Video VAE",
      "default": "ltx-2.5-video-vae-conv-bf16.safetensors",
      "options": [
        {
          "value": "ltx-2.5-video-vae-conv-bf16.safetensors",
          "label": "LTX 2.5 video VAE Conv (bf16, 1.45 GB)"
        },
        {
          "value": "ltx-2.5-video-vae-bf16.safetensors",
          "label": "LTX 2.5 video VAE (bf16)"
        }
      ],
      "bind": [
        {
          "node": "405:385",
          "field": "vae_name"
        }
      ],
      "help": "The video VAE used to decode the clip. Conv bf16 is the new default; the original bf16 stays available."
    },
    {
      "id": "audio_vae_name",
      "type": "select",
      "label": "Audio VAE",
      "default": "ltx-2.5-audio-vae-bf16.safetensors",
      "options": [
        {
          "value": "ltx-2.5-audio-vae-bf16.safetensors",
          "label": "LTX 2.5 audio VAE (bf16)"
        }
      ],
      "bind": [
        {
          "node": "405:386",
          "field": "vae_name"
        }
      ]
    },
    {
      "id": "upscaler",
      "type": "select",
      "label": "Latent upscaler",
      "default": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors",
      "options": [
        {
          "value": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors",
          "label": "LTX 2.5 spatial upscaler x2"
        }
      ],
      "bind": [
        {
          "node": "405:371",
          "field": "model_name"
        }
      ]
    },
    {
      "id": "filename_prefix",
      "type": "text",
      "label": "Filename prefix",
      "default": "riverfield/video-t2v",
      "bind": [
        {
          "node": "75",
          "field": "filename_prefix"
        }
      ]
    },
    {
      "id": "format",
      "type": "select",
      "label": "Container",
      "default": "mp4",
      "options": [
        {
          "value": "mp4",
          "label": "MP4"
        },
        {
          "value": "mkv",
          "label": "MKV"
        },
        {
          "value": "webm",
          "label": "WebM"
        },
        {
          "value": "mov",
          "label": "MOV"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "bind": [
        {
          "node": "75",
          "field": "format"
        }
      ]
    },
    {
      "id": "codec",
      "type": "select",
      "label": "Codec",
      "default": "h264",
      "options": [
        {
          "value": "h264",
          "label": "H.264"
        },
        {
          "value": "av1",
          "label": "AV1"
        },
        {
          "value": "prores",
          "label": "ProRes"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "bind": [
        {
          "node": "75",
          "field": "format.codec"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "75",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "diffusion_models/ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 21.5,
      "phase": "denoise",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "text_encoders/gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "dir": "text_encoders",
      "gb": 15.37,
      "phase": "encode",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "vae/ltx-2.5-video-vae-bf16.safetensors",
      "dir": "vae",
      "gb": 1.47,
      "phase": "decode",
      "gated": true,
      "license": "LTX-2.x Community License",
      "optional": true
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "vae/ltx-2.5-audio-vae-bf16.safetensors",
      "dir": "vae",
      "gb": 0.36,
      "phase": "decode",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "latent_upscale_models/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors",
      "dir": "latent_upscale_models",
      "gb": 1.0,
      "phase": "aux",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Comfy-Org/gemma-4",
      "file": "text_encoders/gemma4_e2b_it_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 5.2,
      "phase": "encode",
      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "vae/ltx-2.5-video-vae-conv-bf16.safetensors",
      "dir": "vae",
      "gb": 1.45,
      "phase": "decode",
      "license": "LTX-2.x Community License",
      "gated": true
    }
  ],
  "credits": [
    "LTX-2.5 by Lightricks",
    "Workflow adapted from ComfyUI's official LTX-2.5 template"
  ],
  "test": {
    "prompt": "waves crashing on black volcanic rocks",
    "duration": 2
  }
}
