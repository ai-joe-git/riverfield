{
  "$schema": "../../schema/app.schema.json",
  "id": "speak",
  "name": "Speak",
  "section": "video",
  "pack": "video-ltx25",
  "status": "ready",
  "higgsfield_feature": "Speak",
  "summary": "A photo says your line out loud: LTX-2.5 makes the voice, the lip sync and the motion in one pass, no TTS model needed.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "video_ltx2_5_i2v.json",
    "comfyui": "0.42.0",
    "notes": "Unchanged official image-to-video template; the prompt quotes the line, which LTX-2.5 voices with synchronized audio. Voice quality still to check in the lab."
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Portrait",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "395",
          "field": "image"
        }
      ]
    },
    {
      "id": "line",
      "type": "textarea",
      "label": "What they say",
      "required": true,
      "default": "Hi! I am talking to you from a single photo. My voice and my lips come from an open model.",
      "help": "One or two sentences fit in five seconds"
    },
    {
      "id": "voice",
      "type": "select",
      "label": "Voice",
      "default": "a warm, friendly female voice",
      "options": [
        {
          "value": "a warm, friendly female voice",
          "label": "Warm, female"
        },
        {
          "value": "a calm, deep male voice",
          "label": "Calm, male"
        },
        {
          "value": "an excited, energetic voice",
          "label": "Excited"
        },
        {
          "value": "a soft, close whisper",
          "label": "Whisper"
        },
        {
          "value": "the clear, confident voice of a news anchor",
          "label": "News anchor"
        },
        {
          "value": "a relaxed voice with a slight smile",
          "label": "Relaxed"
        }
      ]
    },
    {
      "id": "scene",
      "type": "textarea",
      "label": "Shot (optional)",
      "default": "Medium close-up, natural head movement and blinking, soft window light",
      "bind": [
        {
          "node": "398:376",
          "field": "value",
          "template": "{scene}. The person looks into the camera and speaks in {voice}, with natural lip movement, saying: \"{line}\""
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Seconds",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "bind": [
        {
          "node": "398:362",
          "field": "value"
        }
      ]
    },
    {
      "id": "enhance",
      "type": "toggle",
      "label": "Enhance prompt",
      "default": false,
      "help": "Off by default: the enhancer may rephrase your line",
      "bind": [
        {
          "node": "398:383",
          "field": "value"
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Aspect ratio",
      "default": "9:16 (Portrait Widescreen)",
      "options": [
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9"
        },
        {
          "value": "9:16 (Portrait Widescreen)",
          "label": "9:16"
        },
        {
          "value": "1:1 (Square)",
          "label": "1:1"
        },
        {
          "value": "4:3 (Standard)",
          "label": "4:3"
        },
        {
          "value": "3:4 (Portrait Standard)",
          "label": "3:4"
        },
        {
          "value": "21:9 (Ultrawide)",
          "label": "21:9"
        }
      ],
      "bind": [
        {
          "node": "403",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "one_pass",
      "type": "toggle",
      "label": "One-pass full resolution",
      "default": false,
      "help": "On: sample directly at the selected resolution and skip the latent x2 upscaler/second pass. Off: the existing half-resolution first pass + latent x2 second pass.",
      "bind": [
        {
          "node": "398:onepass",
          "field": "value"
        }
      ]
    },
    {
      "id": "upscale",
      "type": "select",
      "label": "RelayVSR upscale",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "None — native LTX resolution"
        },
        {
          "value": "x2",
          "label": "2× — RelayVSR x2 (lightx2v DIT + Flash VAE)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x2_lightx2v_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x2_fp32.safetensors"
            }
          ]
        },
        {
          "value": "x4",
          "label": "4× — RelayVSR x4 (the paper 4× model)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x4_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x4_fp32.safetensors"
            }
          ]
        }
      ],
      "help": "Optional RelayVSR pass on the decoded LTX frames. None keeps the native result; x2/x4 use the matching DIT and Flash VAE, and x4 multiplies pixels by 16 and is slow.",
      "bypass": [
        {
          "node": "vsr_decode",
          "field": "images"
        }
      ]
    },
    {
      "id": "upscale_detail",
      "type": "slider",
      "label": "Upscale detail",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "help": "RelayVSR: how much of what the Flash decoder adds on top of a plain bicubic upscale is kept. 1 is the full model output.",
      "bind": [
        {
          "node": "vsr_decode",
          "field": "detail"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "398:339",
          "field": "noise_seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "75",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "diffusion_models/ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 21.5,
      "phase": "denoise",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "text_encoders/gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "dir": "text_encoders",
      "gb": 15.37,
      "phase": "encode",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "vae/ltx-2.5-video-vae-bf16.safetensors",
      "dir": "vae",
      "gb": 1.47,
      "phase": "decode",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "vae/ltx-2.5-audio-vae-bf16.safetensors",
      "dir": "vae",
      "gb": 0.36,
      "phase": "decode",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Lightricks/LTX-2.5",
      "file": "latent_upscale_models/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors",
      "dir": "latent_upscale_models",
      "gb": 1.0,
      "phase": "aux",
      "gated": true,
      "license": "LTX-2.x Community License"
    },
    {
      "repo": "Comfy-Org/gemma-4",
      "file": "text_encoders/gemma4_e2b_it_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 5.2,
      "phase": "encode",
      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "diffusion_models/relayvsr_x2_lightx2v_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.16,
      "phase": "aux",
      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "vae/relayvsr_flash_vae_x2_fp32.safetensors",
      "dir": "vae",
      "gb": 0.13,
      "phase": "aux",
      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "diffusion_models/relayvsr_x4_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.16,
      "phase": "aux",
      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "vae/relayvsr_flash_vae_x4_fp32.safetensors",
      "dir": "vae",
      "gb": 0.13,
      "phase": "aux",
      "license": "Apache-2.0",
      "optional": true
    }
  ],
  "notes": "Use footage and photos of yourself, fictional characters, or people who agreed to it.",
  "credits": [
    "LTX-2.5 by Lightricks",
    "Workflow adapted from ComfyUI's official LTX-2.5 template"
  ],
  "test": {
    "image": "test/portrait.png",
    "duration": 3
  }
}
