{
  "$schema": "../../schema/app.schema.json",
  "id": "h3-piflow-i2v",
  "name": "pi-H3 DWD Image to Video",
  "section": "video",
  "pack": "video-h3-piflow",
  "status": "ready",
  "higgsfield_feature": "Create Video",
  "summary": "pi-H3 DWD animates a first frame into a video with synchronized audio in 2 or 4 steps, without a VAE video decoder; 0.2–2 MP, up to 40 s.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "pi-H3-DWD.json (pi-H3 FL2VA, DWD)",
    "comfyui": "0.46.0",
    "notes": "pi-H3 DWD on MiniMax H3 FL2VA: 2-step or 4-step DWD adapters predict the video frames at the last sampling step, so the video skips the VAE decoder. The video VAE still encodes the first and last keyframes; the audio VAE decodes the synchronized soundtrack. The pi-Flow scheduler, Load LakonLab Adapter, DWD Decode, BlockSparseAttention and H3 SLA nodes come from the tested pi-H3-DWD workflow. Requires comfyui-piflow 1.4.0 and the local sol_h3.py dtype patch for fp16 adapters on a bf16 base. Text, first-frame and first-and-last-frame conditioning are the three supported pi-H3 modes."
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "First frame",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "100",
          "field": "image"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Prompt",
      "required": true,
      "default": "The person smiles, waves at the camera and says: \"Hey, good to see you.\"",
      "help": "Put spoken words in quotes; describe sounds and music too.",
      "bind": [
        {
          "node": "6",
          "field": "prompt"
        }
      ]
    },
    {
      "id": "steps",
      "type": "select",
      "label": "Steps",
      "default": 2,
      "options": [
        {
          "value": 2,
          "label": "2 (fastest)"
        },
        {
          "value": 4,
          "label": "4 (more detail)"
        }
      ],
      "help": "pi-H3 switches the DWD adapter and the pi-Flow schedule automatically: 2 steps uses max_raw_t 0.93, 4 steps 0.96.",
      "bind": [
        {
          "node": "39:36",
          "field": "value"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Duration (s)",
      "min": 2,
      "max": 40,
      "step": 1,
      "default": 5,
      "help": "24 fps, snapped to the H3 5+17n grid. pi-H3 is tested at 5, 10 and 15 s; longer is untested and costs proportionally more time.",
      "bind": [
        {
          "node": "40:31",
          "field": "value"
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Aspect ratio",
      "default": "16:9 (Widescreen)",
      "options": [
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9"
        },
        {
          "value": "9:16 (Portrait Widescreen)",
          "label": "9:16"
        },
        {
          "value": "1:1 (Square)",
          "label": "1:1"
        },
        {
          "value": "4:3 (Standard)",
          "label": "4:3"
        },
        {
          "value": "3:4 (Portrait Standard)",
          "label": "3:4"
        },
        {
          "value": "21:9 (Ultrawide)",
          "label": "21:9"
        }
      ],
      "bind": [
        {
          "node": "30",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "megapixels",
      "type": "slider",
      "label": "Resolution (MP)",
      "min": 0.2,
      "max": 2.0,
      "step": 0.1,
      "default": 0.97,
      "help": "0.97 MP is 1344x768 in 16:9; 0.4 MP is the fast draft size. The DWD head predicts the frames, so there is no video VAE decode.",
      "bind": [
        {
          "node": "30",
          "field": "megapixels"
        }
      ]
    },
    {
      "id": "multiple",
      "type": "select",
      "label": "Size multiple",
      "default": 32,
      "options": [
        {
          "value": 8,
          "label": "8"
        },
        {
          "value": 16,
          "label": "16"
        },
        {
          "value": 32,
          "label": "32 (H3 default)"
        },
        {
          "value": 64,
          "label": "64"
        }
      ],
      "help": "Keep 32 for H3: the latent patch is 2, so a size multiple of 8 can make the first/last-frame latent odd and the run fails.",
      "bind": [
        {
          "node": "30",
          "field": "multiple"
        }
      ]
    },
    {
      "id": "upscale",
      "type": "select",
      "label": "Upscale",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "None — native model resolution"
        },
        {
          "value": "x2",
          "label": "2× — RelayVSR x2 (lightx2v DIT + Flash VAE)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x2_lightx2v_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x2_fp32.safetensors"
            }
          ]
        },
        {
          "value": "x4",
          "label": "4× — RelayVSR x4 (the paper 4× model)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x4_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x4_fp32.safetensors"
            }
          ]
        }
      ],
      "help": "Optional RelayVSR pass after DWD: none keeps the predicted frames; x2/x4 use the matching DIT and Flash VAE, and x4 multiplies pixels by 16.",
      "bypass": [
        {
          "node": "vsr_decode",
          "field": "images"
        }
      ]
    },
    {
      "id": "upscale_detail",
      "type": "slider",
      "label": "Upscale detail",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "help": "RelayVSR: how much of what the Flash decoder adds on top of a plain bicubic upscale is kept. 1 is the full model output.",
      "bind": [
        {
          "node": "vsr_decode",
          "field": "detail"
        }
      ]
    },
    {
      "id": "clip_name",
      "type": "select",
      "label": "Text encoder",
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "options": [
        {
          "value": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
          "label": "Qwen3-VL 32B NVFP4 (15.7 GB)"
        },
        {
          "value": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
          "label": "Qwen3-VL 32B INT8 (27.1 GB)"
        },
        {
          "value": "qwen3vl_32b_minimax_h3_ultra_uncensored_heretic_int8_convrot.safetensors",
          "label": "Qwen3-VL 32B Heretic INT8 (25 GB)"
        },
        {
          "value": "p-h3-image_text_encoder_int8_convrot.safetensors",
          "label": "p-h3-image text encoder INT8 — 4.8 GB"
        }
      ],
      "bind": [
        {
          "node": "3",
          "field": "clip_name"
        }
      ]
    },
    {
      "id": "vae_name",
      "type": "select",
      "label": "Video VAE",
      "default": "minimax_h3_lynnreal_light_vae_int8_convrot.safetensors",
      "options": [
        {
          "value": "minimax_h3_lynnreal_light_vae_int8_convrot.safetensors",
          "label": "Lynnreal light INT8 (2.1 GB)"
        },
        {
          "value": "minimax_h3_video_vae_int8_convrot.safetensors",
          "label": "Video VAE INT8 (2.8 GB)"
        },
        {
          "value": "minimax_h3_video_vae_fp16.safetensors",
          "label": "Video VAE FP16 (5.2 GB)"
        }
      ],
      "bind": [
        {
          "node": "4",
          "field": "vae_name"
        }
      ]
    },
    {
      "id": "sla_detail",
      "type": "slider",
      "label": "Sparse attention: detail",
      "min": 0.5,
      "max": 0.9,
      "step": 0.05,
      "default": 0.85,
      "help": "Fraction of key blocks skipped by H3 SLA. Lower keeps more exact blocks; 0.85 is the Flash recipe.",
      "bind": [
        {
          "node": "41",
          "field": "sparsity_ratio"
        }
      ]
    },
    {
      "id": "filename_prefix",
      "type": "text",
      "label": "Filename prefix",
      "default": "riverfield/h3-piflow-i2v",
      "bind": [
        {
          "node": "15",
          "field": "filename_prefix"
        }
      ]
    },
    {
      "id": "format",
      "type": "select",
      "label": "Container",
      "default": "mp4",
      "options": [
        {
          "value": "mp4",
          "label": "MP4"
        },
        {
          "value": "mkv",
          "label": "MKV"
        },
        {
          "value": "webm",
          "label": "WebM"
        },
        {
          "value": "mov",
          "label": "MOV"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "bind": [
        {
          "node": "15",
          "field": "format"
        }
      ]
    },
    {
      "id": "codec",
      "type": "select",
      "label": "Codec",
      "default": "h264",
      "options": [
        {
          "value": "h264",
          "label": "H.264"
        },
        {
          "value": "av1",
          "label": "AV1"
        },
        {
          "value": "prores",
          "label": "ProRes"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "bind": [
        {
          "node": "15",
          "field": "format.codec"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "10",
          "field": "noise_seed"
        }
      ]
    },
    {
      "id": "sla",
      "type": "toggle",
      "label": "H3 SLA attention",
      "default": true,
      "help": "The ROCm H3 SLA node. Off, or on a backend that does not ship it: the node is bypassed and the model goes straight to the next attention stage.",
      "bind": [
        {
          "node": "41",
          "field": "enabled"
        }
      ],
      "bypass": [
        {
          "node": "41",
          "field": "model"
        }
      ]
    },
    {
      "id": "block_sparse",
      "type": "toggle",
      "label": "Block sparse attention (Sol-Attn)",
      "default": true,
      "help": "pi-H3's Sol-Attn block sparse attention. Off runs dense attention: slower and more VRAM.",
      "bypass": [
        {
          "node": "20",
          "field": "model"
        }
      ],
      "bind": [
        {
          "node": "200",
          "field": "value"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "15",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors",
