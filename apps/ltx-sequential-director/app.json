{
  "id": "ltx-sequential-director",
  "name": "RiverField LTX Sequential Director",
  "section": "video",
  "pack": "video-ltx25",
  "status": "ready",
  "higgsfield_feature": "AI Director",
  "summary": "Segment-by-segment LTX 2.5 director: last frame feeds the next run, optional final keyframes and hard cuts, approve before assembly.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "LTX 2.5 video (I2V / first-and-last frame)",
    "comfyui": "0.42.0",
    "notes": "The segment graph is the LTX 2.5 video app with its optional last frame. The sequential panel submits that graph once per segment and never relies on an IC-LoRA: it extracts each finished segment’s last frame, feeds it as the next first frame, carries an optional per-segment final keyframe, and lets a cut replace the handoff with a new start image. Segment videos are separate History runs; the final assembly is a bounded ffmpeg concat."
  },
