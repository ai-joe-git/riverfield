      "id": "global_prompt",
      "type": "textarea",
      "label": "Global prompt",
      "required": false,
      "default": "",
      "help": "Used by every segment when ALL segment prompts are empty. Finite sampling requires a local prompt for every segment once any local prompt is supplied.",
      "bind": [
        {
          "node": "prompt_source",
          "field": "value"
        }
      ],
      "hidden": true
    },
    {
      "id": "prompt_enhancer",
      "type": "toggle",
      "label": "Enhance prompt with Qwen3.8",
      "default": true,
      "help": "On by default. Qwen3.8 rewrites the global prompt and every Material Planner segment in order with the matching Pika writer guide (Ref2VA or FL2VA), feeding the previous scenes as context and telling the writer which segment it is enhancing. Segment timing and reference assignments are preserved.",
      "bind": [
        {
          "node": "enh_on",
          "field": "value"
        }
      ]
    },
    {
      "id": "enhancer_model",
      "type": "select",
      "label": "Prompt enhancer model",
      "default": "qwen3.8_27b_uncensored_heretic_w4a8_convrot_v2.safetensors",
      "options": [
        {
          "value": "qwen3.8_27b_w4a8.safetensors",
          "label": "Qwen3.8 27B W4A8 — balanced"
        },
        {
          "value": "qwen3.8_27b_uncensored_heretic_w4a8_convrot_v2.safetensors",
          "label": "Qwen3.8 27B Heretic W4A8 — uncensored"
        }
      ],
      "help": "Local text model used only when the prompt enhancer is on.",
      "bind": [
        {
          "node": "enh_clip",
          "field": "clip_name"
        }
      ]
    },
    {
