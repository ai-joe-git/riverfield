    {
      "id": "megapixels",
      "type": "slider",
      "label": "Resolution (MP)",
      "min": 0.1,
      "max": 2.0,
      "step": 0.1,
      "default": 0.3,
      "help": "Native pixel budget: 0.3 MP in Production or 0.1 MP in Build & Test before any separate RelayVSR upscale. Final dimensions are rounded to the selected multiple.",
      "bind": [
        {
          "node": "41",
          "field": "megapixels"
        }
      ]
    },
    {
      "id": "render_profile",
      "type": "select",
      "label": "Render profile",
      "options": [
        {
          "value": "build",
          "label": "Build & Test — 0.1 MP, no upscale"
        },
        {
          "value": "production",
          "label": "Production — 0.3 MP, RelayVSR x2 by default"
        }
      ],
      "help": "Explicit Build & Test or Production request. Omitting it uses the manifest's declared starting profile, or the historical legacy settings when the app declares none. Production uses 0.3 MP and RelayVSR x2 by default.",
      "hidden": true,
      "derived": true,
      "default": "production"
    },
    {
      "id": "production_megapixels",
      "type": "slider",
      "label": "Production resolution (MP)",
      "min": 0.1,
      "max": 2.0,
      "step": 0.1,
      "default": 0.3,
      "help": "Remembered Production generation resolution. Build & Test never reads it and never changes it.",
      "hidden": true,
      "derived": true
    },
    {
      "id": "production_upscale",
      "type": "select",
      "label": "Production upscale",
      "default": "x2",
      "options": [
        {
          "value": "",
          "label": "Off — native model resolution"
        },
        {
          "value": "x2",
          "label": "X2 — 2× linear, 4× pixel area"
        },
        {
          "value": "x4",
          "label": "X4 — 4× linear, 16× pixel area"
        }
      ],
      "help": "Remembered Production RelayVSR choice. Build & Test always disables upscaling without changing this preference.",
      "hidden": true,
      "derived": true
    },
    {
      "id": "production_upscale_detail",
      "type": "slider",
      "label": "Production upscale detail",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "help": "Remembered RelayVSR decoder detail for Production.",
      "hidden": true,
      "derived": true
    },
    {
      "id": "upscale",
      "type": "select",
      "label": "Upscale",
      "default": "x2",
      "hidden": true,
      "options": [
        {
          "value": "",
          "label": "None — native model resolution",
          "sets": [
            {
              "node": "vsr_switch",
              "field": "switch",
              "value": false
            }
          ]
        },
        {
          "value": "x2",
          "label": "2× — RelayVSR x2 (lightx2v DIT + Flash VAE)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x2_lightx2v_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x2_fp32.safetensors"
            },
            {
              "node": "vsr_switch",
              "field": "switch",
              "value": true
            }
          ]
        },
        {
          "value": "x4",
          "label": "4× — RelayVSR x4 (the paper's 4× model)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x4_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x4_fp32.safetensors"
            },
            {
              "node": "vsr_switch",
              "field": "switch",
              "value": true
            }
          ]
        }
      ],
      "help": "Optional RelayVSR pass on the director's final clip: the video is decoded, upscaled and re-encoded. None keeps the native result; x4 multiplies pixels by 16 and is slow.",
      "bypass": [
        {
          "node": "vsr_switch",
          "field": "on_false"
        }
      ]
    },
    {
      "id": "upscale_detail",
      "type": "slider",
      "label": "Upscale detail",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "hidden": true,
      "help": "RelayVSR: how much of what the Flash decoder adds on top of a plain bicubic upscale is kept. 1 is the full model output, lower is calmer and closer to the source.",
      "bind": [
        {
          "node": "vsr_decode",
          "field": "detail"
        }
      ]
    },
    {
      "id": "multiple",
      "type": "slider",
      "label": "Dimension multiple",
      "min": 8,
      "max": 128,
      "step": 4,
      "default": 32,
      "bind": [
        {
          "node": "41",
          "field": "multiple"
        }
      ]
    },
    {
      "id": "sla",
      "type": "toggle",
      "label": "Sparse attention (H3 SLA)",
      "default": true,
      "help": "The ROCm SLA node. Turn it off on CUDA/XPU, or on a backend that does not ship it: the node is bypassed and the model goes straight to the sampler. It is also bypassed automatically when the backend lacks the class.",
      "bind": [
        {
          "node": "42",
          "field": "enabled"
        }
      ],
      "bypass": [
        {
          "node": "42",
          "field": "model"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "30",
          "field": "seed"
        }
      ]
    },
    {
      "id": "clip_name",
      "type": "select",
      "label": "Text encoder",
      "default": "p-h3-image_text_encoder_int8_convrot.safetensors",
      "options": [
        {
          "value": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
          "label": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors"
        },
        {
          "value": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
          "label": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
        },
        {
          "value": "qwen3vl_32b_minimax_h3_ultra_uncensored_heretic_int8_convrot.safetensors",
          "label": "qwen3vl_32b_minimax_h3_ultra_uncensored_heretic_int8_convrot.safetensors"
        },
        {
          "value": "p-h3-image_text_encoder_int8_convrot.safetensors",
