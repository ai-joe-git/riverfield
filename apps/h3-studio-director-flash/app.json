    {
      "id": "global_prompt",
      "type": "textarea",
      "label": "Global prompt",
      "required": false,
      "default": "",
      "help": "Used by every segment when ALL segment prompts are empty. Finite sampling requires a local prompt for every segment once any local prompt is supplied.",
      "bind": [
        {
          "node": "prompt_source",
          "field": "value"
        }
      ],
      "hidden": true
    },
    {
      "id": "production_id",
      "type": "text",
      "label": "Production Engine ID",
      "hidden": true,
      "required": false,
      "default": "",
      "help": "Optional Production Engine association. When set, canonical memory is injected into the prompt enhancer; otherwise the existing Director context is used.",
      "derived": true
    },
    {
      "id": "production_scene_id",
      "type": "text",
      "label": "Production scene ID",
      "hidden": true,
      "required": false,
      "default": "",
      "help": "Optional scene within production_id, used to select bounded canonical memory.",
      "derived": true
    },
    {
      "id": "prompt_enhancer",
      "type": "toggle",
      "label": "Enhance prompt with Qwen3.8",
      "default": true,
      "help": "On by default. Qwen3.8 rewrites the global prompt and every Material Planner segment in order, feeding the previous scenes as context and telling the writer which segment it is enhancing. Segment timing and reference assignments are preserved.",
      "bind": [
        {
          "node": "enh_on",
          "field": "value"
        }
      ]
    },
    {
      "id": "enhancer_model",
      "type": "select",
      "label": "Prompt enhancer model",
      "default": "qwen3.8_27b_uncensored_heretic_w4a8_convrot_v2.safetensors",
      "options": [
        {
          "value": "qwen3.8_27b_w4a8.safetensors",
          "label": "Qwen3.8 27B W4A8 — balanced"
        },
        {
          "value": "qwen3.8_27b_uncensored_heretic_w4a8_convrot_v2.safetensors",
          "label": "Qwen3.8 27B Heretic W4A8 — uncensored"
        }
      ],
      "help": "Local text model used only when the prompt enhancer is on.",
      "bind": [
        {
          "node": "enh_clip",
          "field": "clip_name"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Segment duration (s)",
      "min": 0.5,
      "max": 60,
      "step": 0.1,
      "default": 7.3,
      "help": "Generation duration of one segment, rounded to an H3-legal 5+17n frame count. Total ≈ segments × duration − seams.",
      "bind": [
        {
          "node": "rfplan",
          "field": "generation_seconds"
        },
        {
          "node": "11",
          "field": "generation_seconds"
        }
      ],
      "hidden": true
    },
    {
      "id": "segment_count",
      "type": "slider",
      "label": "Segments",
      "min": 1,
      "max": 64,
      "step": 1,
      "default": 1,
      "help": "Material segments: each gets its own window and its own line in the segment prompts.",
      "bind": [
        {
          "node": "rfplan",
          "field": "segment_count"
        }
      ],
      "hidden": true
    },
    {
      "id": "segment_prompts",
      "type": "textarea",
      "label": "Segment prompts",
      "required": false,
      "default": "",
      "help": "Legacy line-split field. For Pika's multi-line six-section prompts use global_prompt for the whole prompt or segment_windows for per-segment prompts; do not put them here.",
      "bind": [
        {
          "node": "rfplan",
          "field": "segment_prompts"
        }
      ],
      "hidden": true
    },
    {
      "id": "start_seconds",
      "type": "slider",
      "label": "Timeline start (s)",
      "min": 0,
      "max": 3600,
      "step": 0.5,
      "default": 0,
      "help": "Where the generation window starts on the material timeline.",
      "bind": [
        {
          "node": "rfplan",
          "field": "start_seconds"
        }
      ],
      "hidden": true
    },
    {
      "id": "advanced_timeline_json",
      "type": "textarea",
      "label": "Advanced: raw timeline JSON",
      "required": false,
      "default": "",
      "help": "Non-empty: replaces every planner field above and is passed to the Material Planner unchanged.",
      "bind": [
        {
          "node": "rfplan",
          "field": "advanced_timeline_json"
        }
      ],
      "hidden": true
    },
    {
      "id": "flex_mode",
      "type": "select",
      "label": "H3 Flash model",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "auto — references if present, text-only otherwise"
        },
        {
          "value": "ref2va",
          "label": "ref2va — references → video (needs a picture or a clip)",
          "sets": [
            {
              "node": "1",
              "field": "unet_name",
              "value": "minimax_h3_ref2va_hyperflow_flash_int8_convrot.safetensors"
            }
          ]
        },
        {
          "value": "fl2va",
          "label": "fl2va — optional first / last frames",
          "sets": [
            {
              "node": "1",
              "field": "unet_name",
              "value": "minimax_h3_fl2va_hyperflow_flash_int8_convrot.safetensors"
            }
          ]
        }
      ],
      "help": "Ref2VA uses ordered references per segment. FL2VA uses optional first and last frames per segment; leave both empty for text-to-video. Auto uses endpoint assignments when present, otherwise follows the reference bin. Model and sampler settings remain paired with the selected mode."
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Aspect ratio",
      "default": "16:9 (Widescreen)",
      "options": [
        {
          "value": "1:1 (Square)",
          "label": "1:1 (Square)"
        },
        {
          "value": "2:3 (Portrait Photo)",
          "label": "2:3 (Portrait Photo)"
        },
        {
          "value": "3:2 (Photo)",
          "label": "3:2 (Photo)"
        },
        {
          "value": "3:4 (Portrait Standard)",
          "label": "3:4 (Portrait Standard)"
        },
        {
          "value": "4:3 (Standard)",
          "label": "4:3 (Standard)"
        },
        {
          "value": "9:16 (Portrait Widescreen)",
          "label": "9:16 (Portrait Widescreen)"
        },
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9 (Widescreen)"
        },
        {
          "value": "21:9 (Ultrawide)",
          "label": "21:9 (Ultrawide)"
        }
      ],
      "bind": [
        {
          "node": "41",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "megapixels",
      "type": "slider",
      "label": "Resolution (MP)",
      "min": 0.1,
      "max": 3.0,
      "step": 0.1,
      "default": 0.3,
      "hidden": true,
      "help": "Native pixel budget, 0.1–3.0 MP, owned by the Director's Render profile strip. Build & Test always runs at 0.1 MP; Production uses its own remembered resolution.",
      "bind": [
        {
          "node": "41",
          "field": "megapixels"
        }
      ]
    },
    {
      "id": "render_profile",
      "type": "select",
      "label": "Render profile",
      "options": [
        {
          "value": "build",
          "label": "Build & Test — 0.1 MP, no upscale"
        },
        {
          "value": "production",
          "label": "Production — 0.3 MP, RelayVSR x2 by default"
        }
      ],
      "help": "Explicit Build & Test or Production request. Omitting it uses the manifest's declared starting profile, or the historical legacy settings when the app declares none. The Director panel writes it; agents may request it directly.",
      "hidden": true,
      "derived": true,
      "default": "production"
    },
    {
      "id": "production_megapixels",
      "type": "slider",
      "label": "Production resolution (MP)",
      "min": 0.1,
      "max": 3.0,
      "step": 0.1,
      "default": 0.3,
      "help": "Remembered Production generation resolution. Build & Test never reads it and never changes it.",
      "hidden": true,
      "derived": true
    },
    {
      "id": "production_upscale",
      "type": "select",
      "label": "Production upscale",
      "default": "x2",
      "options": [
        {
          "value": "",
          "label": "Off — native model resolution"
        },
        {
          "value": "x2",
          "label": "X2 — 2× linear, 4× pixel area"
        },
        {
          "value": "x4",
          "label": "X4 — 4× linear, 16× pixel area"
        }
      ],
      "help": "Remembered Production RelayVSR choice. Build & Test always disables upscaling without changing this preference.",
      "hidden": true,
      "derived": true
    },
    {
      "id": "production_upscale_detail",
      "type": "slider",
      "label": "Production upscale detail",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "help": "Remembered RelayVSR decoder detail for Production.",
      "hidden": true,
      "derived": true
    },
    {
      "id": "upscale",
      "type": "select",
      "label": "Upscale",
      "default": "x2",
      "hidden": true,
      "options": [
        {
          "value": "",
          "label": "None — native model resolution",
          "sets": [
            {
              "node": "vsr_switch",
              "field": "switch",
              "value": false
            }
          ]
        },
        {
          "value": "x2",
          "label": "2× — RelayVSR x2 (lightx2v DIT + Flash VAE)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x2_lightx2v_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x2_fp32.safetensors"
            },
            {
              "node": "vsr_switch",
              "field": "switch",
              "value": true
            }
          ]
        },
        {
          "value": "x4",
          "label": "4× — RelayVSR x4 (the paper's 4× model)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x4_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x4_fp32.safetensors"
            },
            {
              "node": "vsr_switch",
              "field": "switch",
              "value": true
            }
          ]
        }
      ],
      "help": "Optional RelayVSR pass on the director's final clip: the video is decoded, upscaled and re-encoded. None keeps the native result; x4 multiplies pixels by 16 and is slow.",
      "bypass": [
        {
          "node": "vsr_switch",
          "field": "on_false"
        }
      ]
    },
    {
      "id": "upscale_detail",
      "type": "slider",
      "label": "Upscale detail",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "hidden": true,
      "help": "RelayVSR: how much of what the Flash decoder adds on top of a plain bicubic upscale is kept. 1 is the full model output, lower is calmer and closer to the source.",
      "bind": [
        {
          "node": "vsr_decode",
          "field": "detail"
        }
      ]
    },
    {
      "id": "multiple",
      "type": "slider",
      "label": "Dimension multiple",
      "min": 8,
      "max": 128,
      "step": 4,
      "default": 32,
      "bind": [
        {
          "node": "41",
          "field": "multiple"
        }
      ],
      "help": "Keep 32 for H3: the latent patch is 2, so a width that is only a multiple of 8 can make the first/last-frame latent odd and the run fails."
    },
    {
      "id": "sla",
      "type": "toggle",
      "label": "Sparse attention (H3 SLA)",
      "default": true,
      "help": "The ROCm SLA node. Turn it off on CUDA/XPU, or on a backend that does not ship it: the node is bypassed and the model goes straight to the sampler. It is also bypassed automatically when the backend lacks the class.",
      "bind": [
        {
          "node": "42",
          "field": "enabled"
        }
      ],
      "bypass": [
        {
          "node": "42",
          "field": "model"
        }
      ]
    },
    {
      "id": "steps",
      "type": "select",
      "label": "Steps",
      "default": 8,
      "options": [
        {
          "value": 4,
          "label": "4 (fastest)"
        },
        {
          "value": 6,
          "label": "6 (fast)"
        },
        {
          "value": 8,
          "label": "8 (default, most detailed)"
        }
      ],
      "help": "HyperFlow's sigma schedule: 4, 6 or 8 steps at CFG 1.0.",
      "bind": [
        {
          "node": "50",
          "field": "steps"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "30",
          "field": "seed"
        }
      ]
    },
    {
      "id": "clip_name",
      "type": "select",
      "label": "Text encoder",
      "default": "p-h3-image_text_encoder_int8_convrot.safetensors",
      "options": [
        {
          "value": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
          "label": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors"
