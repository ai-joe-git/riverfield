{
  "$schema": "../../schema/app.schema.json",
  "id": "character-angles",
  "name": "Character Angles",
  "section": "image",
  "pack": "qwen",
  "status": "ready",
  "summary": "One character photo, eight camera angles, eight separate images: Qwen Image 2.1 edit + Turbo+ (30 steps).",
  "workflow": "workflow.api.json",
  "source": {
    "template": "qwen21-1024-image-edit-full.gui.json",
    "comfyui": "0.43.0",
    "notes": "QwenImage21Cache + CiruTurboPrediction patch the base model; TextEncodeQwenImage21 encodes the source image and the edit instruction (refer to it as <image1>) and returns positive, negative and the latent in one node."
  },
  "outputs": [
    {
      "node": "472",
      "type": "image",
      "label": "Image"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/Qwen-Image",
      "file": "diffusion_models/qwen_image_2.1_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 20.0,
      "phase": "denoise",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Qwen-Image",
      "file": "text_encoders/qwen3vl_8b_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 8.0,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Qwen-Image",
      "file": "vae/qwen_image_2.1_vae_bf16.safetensors",
      "dir": "vae",
      "gb": 0.3,
      "phase": "decode",
      "license": "Apache-2.0"
    }
  ],
  "notes": "The original qwen21-1024-image-edit-full graph: QwenImage21Cache + CiruTurboPrediction (Turbo+) on the base model, 30 steps. Turbo+ rejects fewer than 20 sampler steps, so the slider starts at 20; the saved 4-step value from an older version is now invalid and falls back to 30. SimplePromptBatcher feeds the eight angle lines (hidden in the form) and SaveImage writes one image per angle, not a contact sheet.",
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Character image",
      "required": true,
      "limits": {
        "max_mb": 60
      },
      "bind": [
        {
          "node": "473",
          "field": "image"
        }
      ]
    },
    {
      "id": "prompts",
      "type": "textarea",
      "label": "Angle prompts (one per line)",
      "required": true,
      "default": "Turn the camera to a close-up.\nTurn the camera to a wide-angle lens.\nRotate the camera 45 degrees to the right.\nRotate the camera 90 degrees to the right.\nTurn the camera to an aerial view.\nTurn the camera to a low-angle view.\nRotate the camera 45 degrees to the left.\nRotate the camera 90 degrees to the left.",
      "help": "One camera move per line. SimplePromptBatcher runs the edit once per line and returns one image per angle.",
      "bind": [
        {
          "node": "900",
          "field": "prompts"
        }
      ],
      "prefill": true,
      "hidden": true
    },
    {
      "id": "prepend",
      "type": "text",
      "label": "Prepend",
      "default": "",
      "bind": [
        {
          "node": "900",
          "field": "prepend"
        }
      ],
      "hidden": true
    },
    {
      "id": "append",
      "type": "text",
      "label": "Append",
      "default": "",
      "bind": [
        {
          "node": "900",
          "field": "append"
        }
      ],
      "hidden": true
    },
    {
      "id": "negative_prompt",
      "type": "text",
      "label": "Negative prompt",
      "default": "",
      "bind": [
        {
          "node": "452",
          "field": "negative_prompt"
        }
      ],
      "hidden": true
    },
    {
      "id": "resolution",
      "type": "slider",
      "label": "Resolution",
      "min": 512,
      "max": 1536,
      "step": 64,
      "default": 1024,
      "bind": [
        {
          "node": "452",
          "field": "resolution"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 20,
      "max": 40,
      "step": 1,
      "default": 30,
      "bind": [
        {
          "node": "458",
          "field": "steps"
        }
      ],
      "help": "Turbo+ requires at least 20 steps; the original recipe uses 30."
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": 99,
      "bind": [
        {
          "node": "458",
          "field": "seed"
        }
      ]
    },
    {
      "id": "unet_name",
      "type": "select",
      "label": "Model",
      "default": "qwen_image_2.1_int8_convrot.safetensors",
      "options": [
        {
          "value": "qwen_image_2.1_int8_convrot.safetensors",
          "label": "qwen_image_2.1_int8"
        },
        {
          "value": "qwen_image_2.1_turbo_int8_convrot.safetensors",
          "label": "qwen_image_2.1_turbo_int8"
        }
      ],
      "bind": [
        {
          "node": "451",
          "field": "unet_name"
        }
      ]
    },
    {
      "id": "clip_name",
      "type": "select",
      "label": "Text encoder",
      "default": "qwen3vl_8b_int8_convrot.safetensors",
      "options": [
        {
          "value": "qwen3vl_8b_int8_convrot.safetensors",
          "label": "qwen3vl_8b_int8"
        }
      ],
      "bind": [
        {
          "node": "453",
          "field": "clip_name"
        }
      ]
    },
    {
      "id": "vae_name",
      "type": "select",
      "label": "VAE",
      "default": "qwen_image_2.1_vae_bf16.safetensors",
      "options": [
        {
          "value": "qwen_image_2.1_vae_bf16.safetensors",
          "label": "qwen_image_2.1_vae_bf16"
        }
      ],
      "bind": [
        {
          "node": "454",
          "field": "vae_name"
        }
      ]
    }
  ],
  "layout": "sidebar"
}
