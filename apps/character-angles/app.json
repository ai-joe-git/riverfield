{
  "$schema": "../../schema/app.schema.json",
  "id": "character-angles",
  "name": "Character Angles",
  "section": "image",
  "pack": "qwen",
  "status": "ready",
  "summary": "One character photo, eight camera angles: eight separate images, one per line, with Qwen Image 2.1 edit.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "qwen21-1024-image-edit-full.gui.json",
    "comfyui": "0.43.0",
    "notes": "QwenImage21Cache + CiruTurboPrediction patch the base model; TextEncodeQwenImage21 encodes the source image and the edit instruction (refer to it as <image1>) and returns positive, negative and the latent in one node."
  },
  "outputs": [
    {
      "node": "472",
      "type": "image",
      "label": "Image"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/Qwen-Image",
      "file": "diffusion_models/qwen_image_2.1_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 20.0,
      "phase": "denoise",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Qwen-Image",
      "file": "text_encoders/qwen3vl_8b_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 8.0,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Qwen-Image",
      "file": "vae/qwen_image_2.1_vae_bf16.safetensors",
      "dir": "vae",
      "gb": 0.3,
      "phase": "decode",
      "license": "Apache-2.0"
    }
  ],
  "notes": "SimplePromptBatcher (one prompt per line) drives TextEncodeQwenImage21, so the graph runs once per line and SaveImage writes one image per angle: eight files, not a contact sheet. The graph is the original qwen21-1024-image-edit-full one: QwenImage21Cache + CiruTurboPrediction, base model, 30 steps. The turbo UNET is selectable too (then turn Turbo prediction off and lower the steps).",
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Character image",
      "required": true,
      "limits": {
        "max_mb": 60
      },
      "bind": [
        {
          "node": "473",
          "field": "image"
        }
      ]
    },
    {
      "id": "prompts",
      "type": "textarea",
      "label": "Angle prompts (one per line)",
      "required": true,
      "default": "Turn the camera to a close-up.\nTurn the camera to a wide-angle lens.\nRotate the camera 45 degrees to the right.\nRotate the camera 90 degrees to the right.\nTurn the camera to an aerial view.\nTurn the camera to a low-angle view.\nRotate the camera 45 degrees to the left.\nRotate the camera 90 degrees to the left.",
      "help": "One camera move per line. SimplePromptBatcher runs the edit once per line and returns one image per angle.",
      "bind": [
        {
          "node": "900",
          "field": "prompts"
        }
      ]
    },
    {
      "id": "prepend",
      "type": "text",
      "label": "Prepend",
      "default": "",
      "bind": [
        {
          "node": "900",
          "field": "prepend"
        }
      ]
    },
    {
      "id": "append",
      "type": "text",
      "label": "Append",
      "default": "",
      "bind": [
        {
          "node": "900",
          "field": "append"
        }
      ]
    },
    {
      "id": "negative_prompt",
      "type": "text",
      "label": "Negative prompt",
      "default": "",
      "bind": [
        {
          "node": "452",
          "field": "negative_prompt"
        }
      ]
    },
    {
      "id": "resolution",
      "type": "slider",
      "label": "Resolution",
      "min": 512,
      "max": 1536,
      "step": 64,
      "default": 1024,
      "bind": [
        {
          "node": "452",
          "field": "resolution"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 4,
      "max": 40,
      "step": 1,
      "default": 30,
      "bind": [
        {
          "node": "458",
          "field": "steps"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": 99,
      "bind": [
        {
          "node": "458",
          "field": "seed"
        }
      ]
    },
    {
      "id": "unet_name",
      "type": "select",
      "label": "Model",
      "default": "qwen_image_2.1_int8_convrot.safetensors",
      "options": [
        {
          "value": "qwen_image_2.1_int8_convrot.safetensors",
          "label": "qwen_image_2.1_int8"
        },
        {
          "value": "qwen_image_2.1_turbo_int8_convrot.safetensors",
          "label": "qwen_image_2.1_turbo_int8"
        }
      ],
      "bind": [
        {
          "node": "451",
          "field": "unet_name"
        }
      ]
    },
    {
      "id": "clip_name",
      "type": "select",
      "label": "Text encoder",
      "default": "qwen3vl_8b_int8_convrot.safetensors",
      "options": [
        {
          "value": "qwen3vl_8b_int8_convrot.safetensors",
          "label": "qwen3vl_8b_int8"
        }
      ],
      "bind": [
        {
          "node": "453",
          "field": "clip_name"
        }
      ]
    },
    {
      "id": "vae_name",
      "type": "select",
      "label": "VAE",
      "default": "qwen_image_2.1_vae_bf16.safetensors",
      "options": [
        {
          "value": "qwen_image_2.1_vae_bf16.safetensors",
          "label": "qwen_image_2.1_vae_bf16"
        }
      ],
      "bind": [
        {
          "node": "454",
          "field": "vae_name"
        }
      ]
    },
    {
      "id": "turbo",
      "type": "toggle",
      "label": "Turbo prediction",
      "default": true,
      "help": "CiruTurboPrediction, as in the original workflow. Off for a full-quality pass with more steps.",
      "bind": [
        {
          "node": "471",
          "field": "enabled"
        }
      ]
    }
  ]
}
