{
  "$schema": "../../schema/app.schema.json",
  "id": "h3-photo-turbo",
  "name": "H3 Photo to Video Turbo",
  "section": "video",
  "summary": "Animates a photo into a clip with its own sound on MiniMax H3 with taomate's 3-step turbo LoRA: a sixth of the steps.",
  "higgsfield_feature": "Create Video",
  "pack": "video-h3",
  "status": "ready",
  "workflow": "workflow.api.json",
  "source": {
    "template": "video_minimax_h3_i2v.json",
    "comfyui": "0.42.0",
    "notes": "Local turbo clone of h3-photo (taomate_h3_3step_comfy.safetensors at 3 steps, euler), rebuilt by local/make-turbo-apps.py; the upstream app is untouched. Local controls: resolution slider, duration, steps, sampler, LoRA picker (TaoMate 3-step default), SLA sparsity/block/dense options, optional RelayVSR x2/x4 upscale, DiT and video VAE pickers, text encoder and output settings."
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Photo",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "114",
          "field": "image"
        }
      ]
    },
    {
      "id": "resolution",
      "type": "slider",
      "label": "Resolution (MP)",
      "min": 0.2,
      "max": 1.5,
      "step": 0.02,
      "default": 0.6,
      "help": "Total pixels of the clip, each side rounded to 32. 0.4 MP is about 864×480 at 16:9, 0.8 MP about 1216×688. Attention grows with the square of the frame; on this GPU 1.0 MP and above can run out of memory.",
      "bind": [
        {
          "node": "119",
          "field": "megapixels"
        }
      ]
    },
    {
      "id": "unet_name",
      "type": "select",
      "label": "Diffusion model (DiT)",
      "default": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "options": [
        {
          "value": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
          "label": "MiniMax H3 FL2VA int8 — default, matches this graph"
        },
        {
          "value": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
          "label": "MiniMax H3 Ref2VA int8 — reference-to-video, not this graph"
        },
        {
          "value": "minimax_h3_image_pruned_int8_convrot.safetensors",
          "label": "MiniMax H3 Image int8 — image generation, not this graph"
        }
      ],
      "help": "The diffusion transformer. FL2VA is the checkpoint this graph's conditioning expects; the Ref2VA and Image checkpoints are H3 siblings for other tasks and will not produce a valid clip here.",
      "bind": [
        {
          "node": "105:6",
          "field": "unet_name"
        }
      ]
    },
    {
      "id": "vae_name",
      "type": "select",
      "label": "Video VAE",
      "default": "minimax_h3_video_vae_int8_convrot.safetensors",
      "options": [
        {
          "value": "minimax_h3_video_vae_int8_convrot.safetensors",
          "label": "H3 video VAE int8 — default, 3.2 GB"
        },
        {
          "value": "minimax_h3_video_vae_fp16.safetensors",
          "label": "H3 video VAE fp16 — 5.2 GB, higher precision"
        },
        {
          "value": "minimax_h3_lynnreal_light_vae_int8_convrot.safetensors",
          "label": "H3 LynnReal Light VAE int8 — 2.1 GB, lighter/faster"
        }
      ],
      "help": "The video VAE that decodes the sampled latent. int8 is the default on this GPU; fp16 is heavier and higher precision; LynnReal Light is the smallest and fastest.",
      "bind": [
        {
          "node": "105:11",
          "field": "vae_name"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "What happens",
      "required": true,
      "default": "The person smiles, waves at the camera and says: \"Hey, good to see you.\"",
      "help": "Put spoken words in quotes; describe sounds and music too.",
      "bind": [
        {
          "node": "105:104",
          "field": "prompt"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Duration (s)",
      "min": 1,
      "max": 20,
      "step": 0.5,
      "default": 4,
      "help": "Snapped to H3's 17k+5 frame grid at 24 fps.",
      "bind": [
        {
          "node": "105:111",
          "field": "value"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 2,
      "max": 30,
      "step": 1,
      "default": 3,
      "help": "The TaoMate LoRA is trained for 3 steps; more steps cost time and usually add nothing. Picking another LoRA above sets its own trained step count.",
      "bind": [
        {
          "node": "105:124",
          "field": "value"
        }
      ]
    },
    {
      "id": "sampler",
      "type": "select",
      "label": "Sampler",
      "default": "euler",
      "help": "euler is what the TaoMate LoRA was trained with. Picking another LoRA above sets the sampler it expects; lcm and the dpmpp family are available for experiments.",
      "options": [
        {
          "value": "euler",
          "label": "euler"
        },
        {
          "value": "res_multistep",
          "label": "res_multistep"
        },
        {
          "value": "lcm",
          "label": "lcm"
        },
        {
          "value": "dpmpp_2m",
          "label": "dpmpp_2m"
        },
        {
          "value": "dpmpp_2m_sde",
          "label": "dpmpp_2m_sde"
        },
        {
          "value": "dpmpp_3m_sde",
          "label": "dpmpp_3m_sde"
        },
        {
          "value": "deis",
          "label": "deis"
        },
        {
          "value": "heun",
          "label": "heun"
        },
        {
          "value": "dpm_2",
          "label": "dpm_2"
        },
        {
          "value": "dpm_2_ancestral",
          "label": "dpm_2_ancestral"
        },
        {
          "value": "lms",
          "label": "lms"
        }
      ],
      "bind": [
        {
          "node": "105:17",
          "field": "sampler_name"
        }
      ]
    },
    {
      "id": "lora_name",
      "type": "select",
      "label": "LoRA",
      "default": "taomate_h3_3step_comfy.safetensors",
      "options": [
        {
          "value": "taomate_h3_3step_comfy.safetensors",
          "label": "TaoMate H3 3-step — default, fastest",
          "sync": {
            "steps": 3,
            "sampler": "euler"
          }
        },
        {
          "value": "minimax_h3_fl2v_turbo_4step_v1.2_768p_comfyui_bf16.safetensors",
          "label": "MiniMax H3 FL2V turbo 4-step v1.2 768p",
          "sync": {
            "steps": 4,
            "sampler": "euler"
          }
        },
        {
          "value": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
          "label": "MiniMax H3 FL2V turbo 8-step v1.0",
          "sync": {
            "steps": 8,
            "sampler": "euler"
          }
        },
        {
          "value": "minimax_h3_DMAD_4step_full_lora_avg_rank_39_bf16.safetensors",
          "label": "MiniMax H3 DMAD 4-step",
          "sync": {
            "steps": 4,
            "sampler": "euler"
          }
        },
        {
          "value": "minimax_h3_pdmd_2step_lora_avg_rank_38_bf16.safetensors",
          "label": "MiniMax H3 PDMD 2-step",
          "sync": {
            "steps": 2,
            "sampler": "euler"
          }
        },
        {
          "value": "minimax_h3_pdmd_4step_lora_avg_rank_57_bf16.safetensors",
          "label": "MiniMax H3 PDMD 4-step",
          "sync": {
            "steps": 4,
            "sampler": "euler"
          }
        },
        {
          "value": "minimax_h3_turbo_v4_step600_ema_comfyui.safetensors",
          "label": "MiniMax H3 turbo v4 step600 EMA (4-step)",
          "sync": {
            "steps": 4,
            "sampler": "euler"
          }
        },
        {
          "value": "pika_h3_flex_fl2va_v1_bf16.safetensors",
          "label": "Pika H3 Flex FL2VA v1 (6-step lcm)",
          "sync": {
            "steps": 6,
            "sampler": "lcm"
          }
        }
      ],
      "help": "The LoRA patched onto the diffusion model. Picking a turbo LoRA also sets its trained step count and sampler; the files live in ComfyUI/models/loras.",
      "bind": [
        {
          "node": "105:126",
          "field": "lora_name"
        }
      ]
    },
    {
      "id": "lora_strength",
      "type": "slider",
      "label": "LoRA strength",
      "min": 0,
      "max": 1.5,
      "step": 0.05,
      "default": 1,
      "help": "1.0 is the trained strength. Lower blends the base model back in; higher pushes the LoRA look harder.",
      "bind": [
        {
          "node": "105:126",
          "field": "strength_model"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "105:15",
          "field": "noise_seed"
        },
        {
          "node": "vsr_sampler",
          "field": "seed"
        }
      ]
    },
    {
      "id": "clip_name",
      "type": "select",
      "label": "Text encoder",
      "default": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "options": [
        {
          "value": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
          "label": "Qwen3-VL 32B int8 — native on gfx1151"
        },
        {
          "value": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
          "label": "Qwen3-VL 32B nvfp4 — emulated, slower"
        },
        {
          "value": "qwen3vl_32b_minimax_h3_ultra_uncensored_heretic_int8_convrot.safetensors",
          "label": "Qwen3-VL 32B heretic int8"
        }
      ],
      "help": "int8 runs natively on gfx1151; nvfp4 is emulated here and encodes slower.",
      "bind": [
        {
          "node": "105:13",
          "field": "clip_name"
        }
      ]
    },
    {
      "id": "sla",
      "type": "toggle",
      "label": "Sparse attention (H3 SLA)",
      "default": true,
      "help": "The ROCm SLA node. Turn it off on CUDA/XPU, or on a backend that does not ship it: the node is bypassed and the model goes straight to the sampler. It is also bypassed automatically when the backend lacks the class.",
      "bind": [
        {
          "node": "105:125",
          "field": "enabled"
        }
      ],
      "bypass": [
        {
          "node": "105:125",
          "field": "model"
        }
      ]
    },
    {
      "id": "sla_detail",
      "type": "slider",
      "label": "SLA sparsity",
      "min": 0.8,
      "max": 0.95,
      "step": 0.05,
      "default": 0.9,
      "help": "Fraction of key blocks skipped. 0.90 is the value validated for the ROCm SLA node and about 15% faster than 0.85; 0.85 is the turbo LoRA's original distillation setting.",
      "bind": [
        {
          "node": "105:125",
          "field": "sparsity_ratio"
        }
      ]
    },
    {
      "id": "sla_block_size",
      "type": "select",
      "label": "SLA block size",
      "default": "64",
      "options": [
        {
          "value": "32",
          "label": "32 — finest, best for speech"
        },
        {
          "value": "64",
          "label": "64 — balanced (default)"
        },
        {
          "value": "128",
          "label": "128 — fastest, video only"
        }
      ],
      "help": "How many sequence tokens share one key selection. 64 is the ROCm node's default; 32 is finer and better for speech, 128 is faster but can make audio robotic.",
      "bind": [
        {
          "node": "105:125",
          "field": "block_size"
        }
      ]
    },
    {
      "id": "sla_min_seq_len",
      "type": "number",
      "label": "SLA min sequence length",
      "min": 0,
      "max": 1000000,
      "step": 1024,
      "default": 8192,
      "help": "Sequences shorter than this stay dense. Lower it only when you know the clip is long enough to benefit.",
      "bind": [
        {
          "node": "105:125",
          "field": "min_seq_len"
        }
      ]
    },
    {
      "id": "sla_dense_last_steps",
      "type": "slider",
      "label": "SLA dense last steps",
      "min": 0,
      "max": 8,
      "step": 1,
      "default": 1,
      "help": "Run the last N sampling steps at full attention. 0 matches the turbo LoRA's distillation setup; 1 can recover fine detail for a little more time.",
      "bind": [
        {
          "node": "105:125",
          "field": "dense_last_steps"
        }
      ]
    },
    {
      "id": "sla_protect_audio",
      "type": "toggle",
      "label": "SLA protect audio",
      "default": true,
      "help": "Always attend audio and language-token blocks. Turn it off only for turbo-style uniform sparsity.",
      "bind": [
        {
          "node": "105:125",
          "field": "protect_audio"
        }
      ]
    },
    {
      "id": "sla_stabilize_motion",
      "type": "toggle",
      "label": "SLA stabilize motion",
      "default": false,
      "help": "Bias block selection toward the previous step to reduce faint double-exposure on fast motion. Uses more VRAM.",
      "bind": [
        {
          "node": "105:125",
          "field": "stabilize_motion"
        }
      ]
    },
    {
      "id": "sla_h3_cache",
      "type": "toggle",
      "label": "H3 cache",
      "default": false,
      "help": "Apply the H3 block-stack residual cache before SLA (fixed settings).",
      "bind": [
        {
          "node": "105:125",
          "field": "h3_cache"
        }
      ]
    },
    {
      "id": "sla_reference_protection",
      "type": "toggle",
      "label": "SLA protect video refs",
      "default": false,
      "help": "Protect image/video reference blocks in Light mode. Only matters for reference-driven graphs.",
      "bind": [
        {
          "node": "105:125",
          "field": "reference_protection"
        }
      ]
    },
    {
      "id": "sla_dense_steps",
      "type": "text",
      "label": "SLA dense steps",
      "default": "",
      "help": "Explicit 0-based step indices to force dense, for example '0,1' or '0-2'. Blank means none.",
      "bind": [
        {
          "node": "105:125",
          "field": "dense_steps"
        }
      ]
    },
    {
      "id": "sla_dense_backend",
      "type": "select",
      "label": "SLA dense backend",
      "default": "comfy_kitchen",
      "options": [
        {
          "value": "comfy_kitchen",
          "label": "comfy_kitchen (default)"
        },
        {
          "value": "pytorch",
          "label": "pytorch (reference, no quantization)"
        },
        {
          "value": "auto",
          "label": "auto (whatever is active)"
        },
        {
          "value": "sage:auto",
          "label": "sage:auto"
        },
        {
          "value": "sage:qk_int8_pv_fp16_cuda",
          "label": "sage:qk_int8_pv_fp16_cuda"
        },
        {
          "value": "sage:qk_int8_pv_fp16_triton",
          "label": "sage:qk_int8_pv_fp16_triton"
        },
        {
          "value": "sage:qk_int8_pv_fp8_cuda",
          "label": "sage:qk_int8_pv_fp8_cuda"
        },
        {
          "value": "sage:qk_int8_pv_fp8_cuda++",
          "label": "sage:qk_int8_pv_fp8_cuda++"
        }
      ],
      "help": "Kernel used on dense fall-through steps. comfy_kitchen is the fast default; pytorch is the exact reference.",
      "bind": [
        {
          "node": "105:125",
          "field": "dense_backend"
        }
      ]
    },
    {
      "id": "sla_disable_fp16_accum",
      "type": "toggle",
      "label": "SLA disable fp16 accumulation",
      "default": true,
      "help": "Force off the reduced-precision matmul reduction path. Recommended on H3.",
      "bind": [
        {
          "node": "105:125",
          "field": "disable_fp16_accum"
        }
      ]
    },
    {
      "id": "upscale",
      "type": "select",
      "label": "Upscale",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "None — native model resolution"
        },
        {
          "value": "x2",
          "label": "2× — RelayVSR x2 (lightx2v DIT + Flash VAE)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x2_lightx2v_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x2_fp32.safetensors"
            }
          ]
        },
        {
          "value": "x4",
          "label": "4× — RelayVSR x4 (the paper's 4× model)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x4_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x4_fp32.safetensors"
            }
          ]
        }
      ],
      "help": "Optional RelayVSR pass on the decoded frames before encoding. None keeps the native result; x4 multiplies pixels by 16 and is slow.",
      "bypass": [
        {
          "node": "vsr_decode",
          "field": "images"
        }
      ]
    },
    {
      "id": "upscale_detail",
      "type": "slider",
      "label": "Upscale detail",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "help": "RelayVSR: how much of what the Flash decoder adds on top of a plain bicubic upscale is kept. 1 is the full model output, lower is calmer and closer to the source.",
      "bind": [
        {
          "node": "vsr_decode",
          "field": "detail"
        }
      ]
    },
    {
      "id": "filename_prefix",
      "type": "text",
      "label": "File name prefix",
      "default": "riverfield/h3-photo-turbo",
      "bind": [
        {
          "node": "92",
          "field": "filename_prefix"
        }
      ]
    },
    {
      "id": "format",
      "type": "select",
      "label": "Container",
      "default": "mp4",
      "options": [
        {
          "value": "mp4",
          "label": "mp4"
        },
        {
          "value": "mkv",
          "label": "mkv"
        },
        {
          "value": "webm",
          "label": "webm"
        },
        {
          "value": "mov",
          "label": "mov"
        },
        {
          "value": "auto",
          "label": "auto"
        }
      ],
      "bind": [
        {
          "node": "92",
          "field": "format"
        }
      ]
    },
    {
      "id": "codec",
      "type": "select",
      "label": "Codec",
      "default": "h264",
      "options": [
        {
          "value": "h264",
          "label": "h264"
        },
        {
          "value": "av1",
          "label": "av1"
        },
        {
          "value": "prores",
          "label": "prores"
        },
        {
          "value": "auto",
          "label": "auto"
        }
      ],
      "help": "h264/av1 need mp4 or mkv; prores needs mov or mkv.",
      "bind": [
        {
          "node": "92",
          "field": "format.codec"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "92",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 20.97,
      "phase": "denoise",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "text_encoders/qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 27.14,
      "phase": "encode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_video_vae_int8_convrot.safetensors",
      "dir": "vae",
      "gb": 2.81,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_audio_vae_fp32.safetensors",
      "dir": "vae",
      "gb": 0.61,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "dir": "text_encoders",
      "gb": 15.69,
      "phase": "encode",
      "license": "MiniMax H3 Community License",
      "optional": true
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "diffusion_models/relayvsr_x2_lightx2v_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.16,
      "phase": "denoise",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "vae/relayvsr_flash_vae_x2_fp32.safetensors",
      "dir": "vae",
      "gb": 0.13,
      "phase": "decode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "diffusion_models/relayvsr_x4_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 5.16,
      "phase": "denoise",
      "license": "Apache-2.0",
      "optional": true
    },
    {
      "repo": "Comfy-Org/RelayVSR",
      "file": "vae/relayvsr_flash_vae_x4_fp32.safetensors",
