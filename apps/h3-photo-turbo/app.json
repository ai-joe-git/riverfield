{
  "$schema": "../../schema/app.schema.json",
  "id": "h3-photo-turbo",
  "name": "H3 Photo to Video Turbo",
  "section": "video",
  "summary": "Animates a photo into a clip with its own sound on MiniMax H3 with taomate's 3-step turbo LoRA: a sixth of the steps.",
  "higgsfield_feature": "Create Video",
  "pack": "video-h3",
  "status": "ready",
  "workflow": "workflow.api.json",
  "source": {
    "template": "video_minimax_h3_i2v.json",
    "comfyui": "0.42.0",
    "notes": "Local turbo clone of h3-photo (taomate_h3_3step_comfy.safetensors at 3 steps, euler), rebuilt by local/make-turbo-apps.py; the upstream app is untouched."
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Photo",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "114",
          "field": "image"
        }
      ]
    },
    {
      "id": "resolution",
      "type": "select",
      "label": "Resolution",
      "default": 0.6,
      "help": "Total pixels of the clip: the photo is scaled to it with lanczos and each side rounded to 32, then the model keeps that frame. 0.6 MP is the template's default; more is sharper and slower.",
      "options": [
        {
          "value": 0.4,
          "label": "0.4 MP"
        },
        {
          "value": 0.6,
          "label": "0.6 MP"
        },
        {
          "value": 0.8,
          "label": "0.8 MP"
        }
      ],
      "bind": [
        {
          "node": "119",
          "field": "megapixels"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "What happens",
      "required": true,
      "default": "The person smiles, waves at the camera and says: \"Hey, good to see you.\"",
      "help": "Put spoken words in quotes; describe sounds and music too.",
      "bind": [
        {
          "node": "105:104",
          "field": "prompt"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Duration (s)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "bind": [
        {
          "node": "105:111",
          "field": "value"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 2,
      "max": 30,
      "step": 1,
      "default": 3,
      "help": "The turbo LoRA is trained for 3 steps; more steps cost time and usually add nothing. Fewer look rougher.",
      "bind": [
        {
          "node": "105:124",
          "field": "value"
        }
      ]
    },
    {
      "id": "sampler",
      "type": "select",
      "label": "Sampler",
      "default": "euler",
      "help": "euler is what the turbo LoRA was trained with; res_multistep is the plain app's sampler, smoother at equal steps but slower to settle at 3 or 4.",
      "options": [
        {
          "value": "euler",
          "label": "euler"
        },
        {
          "value": "res_multistep",
          "label": "res_multistep"
        }
      ],
      "bind": [
        {
          "node": "105:17",
          "field": "sampler_name"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "105:15",
          "field": "noise_seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "92",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "dir": "diffusion_models",
      "gb": 20.97,
      "phase": "denoise",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "text_encoders/qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "dir": "text_encoders",
      "gb": 27.14,
      "phase": "encode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_video_vae_int8_convrot.safetensors",
      "dir": "vae",
      "gb": 2.81,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_audio_vae_fp32.safetensors",
      "dir": "vae",
      "gb": 0.61,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    }
  ],
  "credits": [
    "MiniMax H3 (MiniMax H3 Community License)",
    "Turbo LoRA: taomate_h3_3step_comfy.safetensors (local file)"
  ],
  "test": {
    "image": "test/portrait.png",
    "prompt": "she smiles",
    "duration": 2
  },
  "notes": "The same graph as H3 Photo to Video with taomate's 3-step LoRA (strength 1.0) on the diffusion model and the sampler set to euler at 3 steps. The clip keeps the photo's shape; the photo, scaled to 0.6 MP in steps of 32, still sets its size. Local turbo variant, not part of the video-h3 pack: freefield's catalogue has no Hub entry for taomate_h3_3step_comfy.safetensors, so it is not downloaded with the pack. Keep the file in ComfyUI/models/loras."
}
