      "derived": true
    },
    {
      "id": "prompt_enhancer",
      "type": "toggle",
      "label": "Enhance prompt with Qwen3.8",
      "default": true,
      "help": "On by default. Qwen3.8 rewrites the global prompt and every Material Planner segment in order, feeding the previous scenes as context and telling the writer which segment it is enhancing. Segment timing and reference assignments are preserved.",
      "bind": [
        {
          "node": "enh_on",
          "field": "value"
        }
      ]
    },
    {
      "id": "enhancer_model",
