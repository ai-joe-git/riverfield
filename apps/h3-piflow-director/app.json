{
  "$schema": "../../schema/app.schema.json",
  "id": "h3-piflow-director",
  "name": "pi-H3 Director",
  "section": "video",
  "pack": "video-h3-piflow",
  "status": "ready",
  "summary": "pi-H3 Director: multi-shot Material Planner segments on the 2/4/6-step pi-H3 adapters, optional RelayVSR x2/x4, with the standard H3 VAE per segment.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "studio-director + pi-H3 DWD adapters",
    "comfyui": "0.46.0",
    "notes": "The material planner, timeline encoder and finite segment sampler are RiverField/ComfyUI-MiniMaxH3 nodes. Model chain: MiniMax H3 Ref2VA + the pi-H3 2/4-step DWD adapters in a switch, H3 SLA, then pi-Flow Scheduler. The finite segment sampler decodes each segment with the standard H3 VAE: DWD Decode only works for the single-shot pi-H3 graph, not inside the multi-segment sampler. Use the single-shot pi-H3 DWD apps when the VAE-free DWD decode matters."
  },
