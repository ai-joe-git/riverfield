        {
          "value": "ming_image_0.1_ling_mini_2.0_w4a8.safetensors",
          "label": "ming_image_0.1_ling_mini_2.0_w4a8.safetensors"
        },
        {
          "value": "minimax_music3_text_encoder_pruned_int8_convrot.safetensors",
