    {
      "id": "prompt",
      "type": "textarea",
      "label": "Prompt",
      "required": true,
      "default": "A street cook in Mexico City flips tacos on a hot griddle, steam and sizzling sound. He looks up and says: \"Two more coming right up!\" The camera pushes in slowly.",
      "help": "Reference the slots by name: <Picture 1>, <Video 1>, <Audio 1>. Spoken words go in quotes.",
      "bind": [
        {
          "node": "138",
          "field": "value"
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Format",
      "default": "16:9 (Widescreen)",
      "options": [
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9"
        },
        {
          "value": "9:16 (Portrait Widescreen)",
          "label": "9:16"
        },
        {
          "value": "1:1 (Square)",
          "label": "1:1"
        },
        {
          "value": "4:3 (Standard)",
          "label": "4:3"
        },
        {
          "value": "3:4 (Portrait Standard)",
          "label": "3:4"
        },
        {
          "value": "3:2 (Photo)",
          "label": "3:2"
        },
        {
          "value": "2:3 (Portrait Photo)",
          "label": "2:3"
        },
        {
          "value": "21:9 (Ultrawide)",
          "label": "21:9"
        }
      ],
      "bind": [
        {
          "node": "115",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "megapixels",
      "type": "slider",
      "label": "Resolution (MP)",
      "min": 0.4,
      "max": 1.5,
      "step": 0.1,
      "default": 0.4,
      "help": "Total pixels of the clip, sides rounded to 32. 0.4 MP is 832x480 at 16:9; higher is sharper and much slower.",
      "bind": [
        {
          "node": "115",
          "field": "megapixels"
        }
      ]
    },
    {
      "id": "multiple",
      "type": "select",
      "label": "Size multiple",
      "default": 32,
      "options": [
        {
          "value": 8,
          "label": "8"
        },
        {
          "value": 16,
          "label": "16"
        },
        {
          "value": 32,
          "label": "32 (H3 default)"
        },
        {
          "value": 64,
          "label": "64"
        }
      ],
      "help": "Keep 32 for H3: the latent patch is 2, so a size multiple of 8 can make the first/last-frame latent odd and the run fails.",
      "bind": [
        {
          "node": "115",
          "field": "multiple"
        }
      ]
    },
    {
      "id": "clip_name",
      "type": "select",
      "label": "Text encoder",
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "options": [
        {
          "value": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
          "label": "Qwen3-VL 32B NVFP4 (15.7 GB)"
        },
        {
          "value": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
          "label": "Qwen3-VL 32B INT8 (27.1 GB)"
        },
        {
          "value": "qwen3vl_32b_minimax_h3_ultra_uncensored_heretic_int8_convrot.safetensors",
          "label": "Qwen3-VL 32B Heretic INT8 (25 GB)"
        },
        {
          "value": "p-h3-image_text_encoder_int8_convrot.safetensors",
          "label": "p-h3-image text encoder INT8 — 4.8 GB"
        }
      ],
      "bind": [
        {
          "node": "128",
          "field": "clip_name"
        }
      ]
    },
    {
      "id": "vae_name",
      "type": "select",
      "label": "Video VAE (keyframes only)",
      "default": "minimax_h3_lynnreal_light_vae_int8_convrot.safetensors",
      "options": [
        {
          "value": "minimax_h3_lynnreal_light_vae_int8_convrot.safetensors",
          "label": "Lynnreal light INT8 (2.1 GB)"
        },
        {
          "value": "minimax_h3_video_vae_int8_convrot.safetensors",
          "label": "Video VAE INT8 (2.8 GB)"
        },
        {
          "value": "minimax_h3_video_vae_fp16.safetensors",
          "label": "Video VAE FP16 (5.2 GB)"
        }
      ],
      "bind": [
        {
          "node": "119",
          "field": "vae_name"
        }
      ],
      "help": "The video VAE encodes reference pictures/keyframes; DWD predicts the output frames."
    },
    {
      "id": "filename_prefix",
      "type": "text",
      "label": "Filename prefix",
      "default": "riverfield/h3-piflow-r2v",
      "bind": [
        {
          "node": "92",
          "field": "filename_prefix"
        }
      ]
    },
    {
      "id": "format",
      "type": "select",
      "label": "Container",
      "default": "mp4",
      "options": [
        {
          "value": "mp4",
          "label": "MP4"
        },
        {
          "value": "mkv",
          "label": "MKV"
        },
        {
          "value": "webm",
          "label": "WebM"
        },
        {
          "value": "mov",
          "label": "MOV"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "bind": [
        {
          "node": "92",
          "field": "format"
        }
      ]
    },
    {
      "id": "codec",
      "type": "select",
      "label": "Codec",
      "default": "h264",
      "options": [
        {
          "value": "h264",
          "label": "H.264"
        },
        {
          "value": "av1",
          "label": "AV1"
        },
        {
          "value": "prores",
          "label": "ProRes"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "bind": [
        {
          "node": "92",
          "field": "format.codec"
        }
      ]
    },
    {
      "id": "upscale",
      "type": "select",
      "label": "Upscale",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "None — native model resolution"
        },
        {
          "value": "x2",
          "label": "2× — RelayVSR x2 (lightx2v DIT + Flash VAE)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x2_lightx2v_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x2_fp32.safetensors"
            }
          ]
        },
        {
          "value": "x4",
          "label": "4× — RelayVSR x4 (the paper's 4× model)",
          "sets": [
            {
              "node": "vsr_unet",
              "field": "unet_name",
              "value": "relayvsr_x4_int8_convrot.safetensors"
            },
            {
              "node": "vsr_vae",
              "field": "vae_name",
              "value": "relayvsr_flash_vae_x4_fp32.safetensors"
            }
          ]
        }
      ],
      "help": "Optional RelayVSR pass on the decoded frames before encoding. None keeps the native result; x2/x4 use the matching DIT and Flash VAE, and x4 multiplies pixels by 16 and is slow.",
      "bypass": [
        {
          "node": "vsr_decode",
          "field": "images"
        }
      ]
    },
    {
      "id": "upscale_detail",
      "type": "slider",
      "label": "Upscale detail",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "help": "RelayVSR: how much of what the Flash decoder adds on top of a plain bicubic upscale is kept. 1 is the full model output, lower is calmer and closer to the source.",
      "bind": [
        {
          "node": "vsr_decode",
          "field": "detail"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Seconds",
      "min": 1,
      "max": 40,
      "step": 1,
      "default": 5,
      "help": "24 fps, snapped to the H3 5+17n grid. pi-H3 is tested at 5, 10 and 15 s; longer is untested and costs proportionally more time.",
      "bind": [
        {
          "node": "132",
          "field": "value"
        }
      ]
    },
    {
      "id": "sampler",
      "type": "select",
      "label": "Sampler",
      "default": "euler",
      "options": [
        {
          "value": "euler",
          "label": "euler"
        }
      ],
      "help": "pi-H3 uses the euler pi-Flow schedule.",
      "bind": [
        {
          "node": "123",
          "field": "sampler_name"
        }
      ]
    },
    {
      "id": "sla",
      "type": "toggle",
      "label": "Sparse attention (Sol-Attn)",
      "default": true,
      "help": "The ROCm SLA node. Off (or a backend without the class): the node is bypassed and the model goes straight to the sampler — use it on CUDA/XPU.",
      "bind": [
        {
          "node": "160",
          "field": "enabled"
        }
      ],
      "bypass": [
        {
          "node": "160",
          "field": "model"
        }
      ]
    },
    {
      "id": "detail",
      "type": "slider",
      "label": "Sparse attention: detail",
      "min": 0.5,
      "max": 0.9,
      "step": 0.05,
      "default": 0.7,
      "help": "0.9 = 90% des blocs ignorés (le plus rapide, 19 min pour 8 s à 0.8 MP). 0.7 = 30% de blocs exacts (~24 min, bien meilleur sur le mouvement). 0.5 = 50% (~30 min). 0.0 = dense (52 min).",
      "bind": [
        {
          "node": "160",
          "field": "sparsity_ratio"
        }
      ]
    },
    {
      "id": "steps",
      "type": "select",
      "label": "Steps",
      "default": 2,
      "options": [
        {
          "value": 2,
          "label": "2 (fastest)"
        },
        {
          "value": 4,
          "label": "4 (more detail)"
        }
      ],
      "help": "Switches the pi-H3 adapter and the pi-Flow schedule: 2 steps uses max_raw_t 0.93, 4 steps 0.96.",
      "bind": [
        {
          "node": "39:36",
          "field": "value"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed.",
      "bind": [
        {
          "node": "129",
          "field": "noise_seed"
        }
      ]
    }
  ],
