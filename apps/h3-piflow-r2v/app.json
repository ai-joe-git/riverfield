{
  "$schema": "../../schema/app.schema.json",
  "id": "h3-piflow-r2v",
  "name": "pi-H3 DWD Reference to Video",
  "section": "video",
  "pack": "video-h3-piflow",
  "status": "ready",
  "higgsfield_feature": "Reference to Video",
  "summary": "pi-H3 DWD reference-to-video: reference pictures, clips and audio on the 2/4-step DWD adapters; experimental on Ref2VA.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "h3-r2v + pi-H3 DWD adapters",
    "comfyui": "0.46.0",
    "notes": "MiniMax H3 Ref2VA + the pi-H3 2/4-step DWD adapters, pi-Flow Scheduler, H3 SLA and DWD Decode. The adapters are documented for FL2VA text/first/last conditioning; reference tokens on the Ref2VA base are experimental and must be tested before relying on them. The audio VAE still decodes the soundtrack; DWD predicts the video frames."
  },
